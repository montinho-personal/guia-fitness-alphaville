---
import { comDestaque as __comDestaque, academias as __academias } from '../lib/dados';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import fotoCapa from '../assets/montinho/montinho-capa-home.jpg';
import CartaoAcademia from '../components/CartaoAcademia.astro';
import Ferramentas from '../components/Ferramentas.astro';
import Mantem from '../components/Mantem.astro';
import CampoBusca from '../components/CampoBusca.astro';
import Vitrine from '../components/Vitrine.astro';
import { academias, guias, REGIOES, MODALIDADES, urlRegiao } from '../lib/dados';

const todas = await academias();
const gs = await guias();
const destaque = ['arena-18-alphaville', 'gavioes-24h-alphaville', 'ironberg-alphaville', 'nitrogym-tambore', 'smart-fit-barueri-av-zelia', 'six-alphaville'];
const cartoes = destaque.map((id) => todas.find((a) => a.id === id)).filter(Boolean);
const porRegiao = (r: string) => todas.filter((a) => a.data.regiao === r).length;
// Data real da última conferência entre todas as fichas: é a prova da promessa "com fonte e data".
const ultima = new Date(Math.max(...todas.flatMap((x) => x.data.proveniencia.map((pv) => pv.conferido_em.getTime()))));
const ultimaIso = ultima.toISOString().slice(0, 10);
// Capa com foto do Montinho (publicada em 18/11/2026, a pedido do Renato). PUBLIC_CAPA_COM_FOTO=false volta à capa só tipográfica.
const CAPA_COM_FOTO = import.meta.env.PUBLIC_CAPA_COM_FOTO !== 'false';
const ultimaCurta = ultimaIso.split('-').reverse().join('.');
const mods = [...new Set(todas.flatMap((a) => a.data.modalidades))];
const abs = (u: string) => new URL(u, Astro.site).href;
const schema = [
  { '@type': 'WebSite', '@id': abs('/#site'), url: abs('/'), name: 'Guia Fitness Alphaville', inLanguage: 'pt-BR', publisher: { '@id': abs('/#org') }, potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${abs('/busca/')}?q={search_term_string}` }, 'query-input': 'required name=search_term_string' } },
  { '@type': 'Organization', '@id': abs('/#org'), name: 'Guia Fitness Alphaville', url: abs('/'), logo: { '@type': 'ImageObject', url: abs('/icon.png'), width: 512, height: 512 }, description: 'Guia local de academias e treino em Alphaville, Barueri e Santana de Parnaíba. Mantido por Montinho Personal Trainer.', parentOrganization: { '@type': 'Organization', name: 'Montinho Personal Trainer', url: 'https://www.montinhopersonal.com.br', sameAs: ['https://www.instagram.com/montinho_personal/'] } },
];
const lista = [
  { url: '/academias/precos/', t: 'Quanto custa academia em Alphaville e Barueri', p: 'As mensalidades que as academias publicam, com fonte e data, e o plano de agregador das que não publicam.' },
  { url: '/guias/smart-fit-ou-gavioes/', t: 'Smart Fit ou Gaviões em Alphaville', p: 'Horário, preço, modalidades e agregadores das duas lado a lado, e qual combina com cada rotina.' },
  { url: '/guias/gavioes-ou-ironberg/', t: 'Gaviões 24h ou Ironberg', p: 'As duas academias 24 horas de Alphaville comparadas: preço, aulas, espaço e estacionamento.' },
  { url: '/academias/perto-de/', t: 'Academia perto de você', p: 'Iguatemi, Shopping Tamboré, 18 do Forte, Parque Shopping e estações da CPTM.' },
  { url: '/guias/ironberg-ou-nitrogym/', t: 'Ironberg ou NitroGym', p: 'As duas academias de musculação de padrão mais alto com preço publicado: quanto custa o primeiro ano em cada uma.' },
  { url: '/ferramentas/academias-abertas-alphaville/', t: 'Academias abertas aos domingos e 24h', p: 'Busque pelo dia, pela hora em que você chega e pela duração do treino: só aparece quem fica aberta até o fim.' },
  { url: '/academias/wellhub-totalpass/', t: 'Academias com Wellhub e TotalPass', p: 'O plano mínimo que cada academia exige em cada agregador, e quanto esse plano custa.' },
  ...gs.filter((g) => g.data.secao === 'guias' && !g.id.startsWith('personal-trainer-') && !/hyrox/.test(g.id)).map((g) => ({ url: `/guias/${g.id}/`, t: g.data.h1, p: g.data.descricao })),
];
const __todasDestaque = await __academias();
const __cartoesDestaque = __comDestaque(cartoes.filter((x): x is NonNullable<typeof x> => !!x), __todasDestaque);
---
<Base titulo="Guia Fitness Alphaville: academias com fonte e data" descricao="Guia local de academias em Alphaville, Tamboré, Barueri e Santana de Parnaíba. Endereço, horários e planos de cada uma, com a fonte e a data de conferência." schema={schema} semSufixo>
  <!-- Capa: cartaz tipográfico. A promessa do guia ("com fonte e data") vira o desenho: data real da última conferência e índice das regiões em números. -->
  <section class:list={['capa', { 'com-foto': CAPA_COM_FOTO }]} aria-labelledby="capa-t">
    <div class="wrap">
      <p class="capa-topo"><span>Guia local de academias</span><span class="capa-data">Conferido em <time datetime={ultimaIso}>{ultimaCurta}</time></span></p>
      {CAPA_COM_FOTO && <figure class="capa-foto"><Image src={fotoCapa} alt="Montinho, personal trainer que mantém o guia, segurando um par de halteres na sala de musculação" widths={[480, 760, 1100]} sizes="(max-width: 899px) 100vw, 520px" loading="eager" fetchpriority="high" /><figcaption>Montinho, personal trainer que mantém este guia</figcaption></figure>}
      <h1 id="capa-t"><span>Onde treinar</span> <span>em Alphaville,</span> <em>com fonte e&nbsp;data.</em></h1>
      <div class="capa-meio">
        <p class="capa-sub">{todas.length} academias, boxes e estúdios em Alphaville, Tamboré, Barueri e Santana de Parnaíba. Cada endereço, horário e plano mostra de onde veio e quando foi conferido.</p>
        <div class="capa-busca"><CampoBusca id="busca-home" placeholder="Gaviões, personal no Tamboré, 24 horas…" /></div>
      </div>
      <nav class="capa-indice" aria-label="Comece pela sua região">
        {Object.entries(REGIOES).map(([id, r]) => (
          <a href={urlRegiao(id)} data-evento="clique_regiao" data-ref={`capa:${id}`}>
            <b aria-hidden="true">{porRegiao(id)}</b>
            <span><strong>{r.titulo}</strong><small><span class="so-leitor">{porRegiao(id)} </span>com ficha</small></span>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="bloco capa-filtro" aria-label="Encontrar academias">
    <div class="wrap">
      <form class="painel" action="/academias/" method="get" aria-label="Encontrar academias">
        <span class="rotulo cor-marca" style="display:block;margin-bottom:12px">Ou filtre pelo que você precisa</span>
        <div class="campos c3">
          <label class="campo"><span class="rotulo">Região</span>
            <select name="regiao"><option value="">Toda a região</option>{Object.entries(REGIOES).map(([id, r]) => <option value={id}>{r.titulo}</option>)}</select></label>
          <label class="campo"><span class="rotulo">Modalidade</span>
            <select name="modalidade"><option value="">Qualquer uma</option>{mods.map((m) => <option value={m}>{MODALIDADES[m]}</option>)}</select></label>
          <label class="campo"><span class="rotulo">Precisa de</span>
            <select name="filtro"><option value="">Sem exigência</option><option value="h24">Aberta 24 horas</option><option value="domingo">Aberta aos domingos</option><option value="cedo">Abrir antes das 6h</option><option value="estacionamento">Estacionamento</option></select></label>
        </div>
        <button class="btn" type="submit" style="margin-top:14px">Ver academias <i aria-hidden="true"></i></button>
        <p style="margin:12px 0 0;font-size:15px;color:var(--cinza)">Sem cadastro. O resultado abre no guia, já filtrado. 18 do Forte e Tamboré estão na página de Alphaville; Aldeia da Serra entra quando houver dados conferidos.</p>
      </form>
    </div>
  </section>
  <style>
    .capa { background: #101B2D; color: #F5F1E8; padding: 22px 0 0; overflow: hidden; }
    .capa-topo { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 0; padding-bottom: 14px; border-bottom: 1px solid rgba(245,241,232,.28); font: 700 11px/1.3 var(--display); letter-spacing: .16em; text-transform: uppercase; }
    .capa-data { color: #FF6A00; }
    .capa h1 { margin: clamp(22px, 3.4vw, 44px) 0 clamp(20px, 3vw, 36px); font-size: clamp(42px, 13.2vw, 118px); font-weight: 800; letter-spacing: -.055em; line-height: .88; color: #F5F1E8; text-wrap: balance; }
    .capa h1 span { display: block; }
    .capa h1 em { display: block; font-style: normal; color: #FF6A00; }
    .capa-meio { display: grid; gap: 18px; padding-bottom: clamp(24px, 3vw, 36px); }
    .capa-sub { margin: 0; max-width: 30em; font-size: clamp(17px, 1.6vw, 21px); line-height: 1.5; color: #D9DEE7; }
    .capa-busca :global(.campo-busca) { border-color: #F5F1E8; max-width: none; }
    .capa-indice { display: grid; border-top: 1px solid rgba(245,241,232,.28); }
    .capa-indice a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 16px 0; color: #F5F1E8; text-decoration: none; border-bottom: 1px solid rgba(245,241,232,.28); }
    .capa-indice a:last-child { border-bottom: 0; }
    .capa-indice b { font: 800 clamp(54px, 15vw, 64px)/.85 var(--display); letter-spacing: -.06em; color: #FF6A00; min-width: 1.25em; font-variant-numeric: tabular-nums; }
    .capa-indice strong { display: block; font: 700 clamp(19px, 5vw, 22px)/1.15 var(--display); letter-spacing: -.02em; }
    .capa-indice small { display: block; margin-top: 4px; font: 700 11px/1 var(--display); letter-spacing: .16em; text-transform: uppercase; color: #AEB7C6; }
    .capa-indice i { font: 400 26px/1 var(--display); font-style: normal; color: #FF6A00; transition: transform .18s; }
    .capa-indice a:hover i, .capa-indice a:focus-visible i { transform: translateX(6px); }
    .capa-indice a:hover strong { text-decoration: underline; text-decoration-color: #FF6A00; text-underline-offset: 5px; }
    .capa-indice a:focus-visible { outline: 3px solid #FF6A00; outline-offset: -3px; }
    .capa-filtro { padding-top: 28px; padding-bottom: 28px; }
    /* Versão com foto: preto e branco, sangrando à direita, com o título por cima. */
    .com-foto .wrap { position: relative; }
    .capa-foto { position: relative; margin: 0 -20px; height: 60vw; max-height: 360px; overflow: hidden; }
    .capa-foto :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 10%; filter: grayscale(1) contrast(1.18) brightness(.92); display: block; }
    .capa-foto::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,27,45,.15) 0%, rgba(16,27,45,0) 35%, rgba(16,27,45,.82) 78%, #101B2D 100%); }
    .capa-foto figcaption { position: absolute; z-index: 2; left: 20px; top: 10px; font: 700 10px/1.2 var(--display); letter-spacing: .14em; text-transform: uppercase; color: #F5F1E8; text-shadow: 0 1px 6px rgba(0,0,0,.6); }
    .com-foto .capa-topo { position: relative; z-index: 2; }
    .com-foto h1 { position: relative; z-index: 2; margin-top: -1.3em; }
    .com-foto .capa-meio, .com-foto .capa-indice { position: relative; z-index: 2; }
    @media (min-width: 900px) {
      .capa { padding-top: 30px; }
      .capa-meio { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; align-items: end; }
      .capa-indice { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .capa-indice a { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "n n" "t s"; align-items: end; gap: 6px 12px; padding: 20px 28px 26px 0; border-bottom: 0; border-right: 1px solid rgba(245,241,232,.28); }
      .capa-indice a + a { padding-left: 28px; }
      .capa-indice a:last-child { border-right: 0; padding-right: 0; }
      .capa-indice b { grid-area: n; font-size: clamp(84px, 8vw, 112px); }
      .capa-indice a > span { grid-area: t; }
      .capa-indice i { grid-area: s; font-size: 34px; }
      .capa-foto { position: absolute; margin: 0; right: calc(50% - 50vw); top: 38px; width: calc(42% + 50vw - 50%); height: auto; bottom: 0; max-height: none; }
      .capa-foto :global(img) { object-position: 50% 8%; }
      .capa-foto::after { background: linear-gradient(90deg, #101B2D 0%, rgba(16,27,45,.55) 28%, rgba(16,27,45,0) 60%), linear-gradient(180deg, rgba(16,27,45,0) 55%, rgba(16,27,45,.9) 88%, #101B2D 100%); }
      .capa-foto figcaption { left: 18px; top: 14px; white-space: nowrap; }
      .com-foto h1 { margin-top: clamp(20px, 2.6vw, 34px); margin-bottom: clamp(16px, 2vw, 26px); font-size: clamp(42px, 13.2vw, 108px); }
      .com-foto .capa-sub { font-size: 18px; }
      .com-foto .capa-meio { padding-bottom: 26px; }
      .com-foto .capa-busca { max-width: 520px; }
      .com-foto .capa-meio { grid-template-columns: minmax(0, 1fr); max-width: 56%; gap: 18px; }
    }
    @media (prefers-reduced-motion: reduce) { .capa-indice i { transition: none; } }
  </style>

  <section class="confianca" aria-label="Como o guia funciona">
    <div class="wrap">
      <ul>
        <li><b>Dado com origem</b>Endereço, horário e plano mostram a fonte e a data da última conferência. <a href="/metodologia/">Metodologia</a>.</li>
        <li><b>Sem posição paga</b>Nenhuma academia paga para aparecer ou para subir na lista.</li>
        <li><b>Quem mantém</b>Montinho Personal Trainer, que atende presencialmente na região. <a href="/sobre/">Como isso funciona</a>.</li>
      </ul>
    </div>
  </section>

  <section class="bloco">
    <div class="wrap">
      <div class="cab">
        <div><span class="rotulo cor-marca">Guia de academias</span><h2>{todas.length} academias com ficha</h2></div>
        <a class="link-forte" href="/academias/">Ver todas, com filtros</a>
      </div>
      <div class="cartoes">{__cartoesDestaque.map((a) => <CartaoAcademia a={a} />)}</div>
    </div>
  </section>

  <section class="bloco escuro">
    <div class="wrap">
      <div class="cab">
        <div><span class="rotulo cor-marca">Ferramentas</span><h2>Decida com os dados na mão</h2></div>
        <a class="link-forte" href="/ferramentas/">Todas as ferramentas</a>
      </div>
      <Ferramentas />
    </div>
  </section>

  <section class="bloco">
    <div class="wrap">
      <div class="cab">
        <div><span class="rotulo cor-marca">Guias de decisão</span><h2>Antes de assinar o plano</h2></div>
        <a class="link-forte" href="/guias/">Todos os guias</a>
      </div>
      <ol class="guias">{lista.map((g) => <li><a href={g.url}><h3>{g.t}</h3><p>{g.p}</p></a></li>)}</ol>
      <p class="prosa" style="margin-top:18px"><strong>Personal trainer por região:</strong> <a href="/guias/personal-trainer-alphaville/">Alphaville</a> · <a href="/guias/personal-trainer-tambore/">Tamboré</a> · <a href="/guias/personal-trainer-barueri/">Barueri</a> · <a href="/guias/personal-trainer-santana-de-parnaiba/">Santana de Parnaíba</a> · <a href="/guias/personal-trainer-aldeia-da-serra/">Aldeia da Serra</a></p>
    </div>
  </section>

  <div class="wrap"><Vitrine pagina="home" intro="Este guia é mantido pelo Montinho Personal Trainer. A vitrine abaixo fica separada da avaliação das academias e mostra resultados de alunos dele, todos de emagrecimento." /></div>
  <section class="bloco" style="padding-top:0"><div class="wrap"><Mantem pagina="home" /></div></section>
</Base>
