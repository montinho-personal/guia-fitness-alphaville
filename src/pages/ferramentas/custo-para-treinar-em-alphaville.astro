---
import VideoApp from '../../components/VideoApp.astro';
import Base from '../../layouts/Base.astro';
import Perguntas from '../../components/Perguntas.astro';
import LeiaTambem from '../../components/LeiaTambem.astro';
import { academias, conferidoEm, dataCurta, dataLonga, linkMontinho, linkWhatsapp, urlAcademia, WHATSAPP, REGIOES } from '../../lib/dados';
import { calcular, cenarioVazio, planosMensais, reais, type Cenario } from '../../lib/custo';
import { politicaPE, prefillTaxa, STATUS_PE } from '../../lib/personal';

const URL_PAG = '/ferramentas/custo-para-treinar-em-alphaville/';
const todas = await academias(); // já vem com o destaque da casa em primeiro

// Dados para a calculadora: nome, unidade, ficha e, quando houver, os planos mensais publicados com fonte e data.
const fonteMensalidade = (a: (typeof todas)[number]) => a.data.proveniencia.find((p) => p.campos.includes('mensalidade'));
const lista = todas.map((a) => {
  const m = a.data.mensalidade;
  const f = fonteMensalidade(a);
  return {
    id: a.id, nome: a.data.nome, bairro: a.data.bairro, regiaoNome: REGIOES[a.data.regiao].nome, url: urlAcademia(a),
    planos: m ? planosMensais(m.planos as { nome: string; preco: string; condicoes: string }[]) : [],
    fonte: m ? m.fonte : null, fonteUrl: m ? m.url : null,
    conferido: f ? dataCurta(f.conferido_em) : dataCurta(conferidoEm(a)),
    abrangencia: m?.abrangencia ?? null,
    estacionamento: a.data.comodidades.filter((c) => /estacionamento|valet|manobrista/i.test(c)),
    ags: a.data.agregadores.map((g) => ({ nome: g.nome, plano_minimo: g.plano_minimo, preco_plano: g.preco_plano })),
    pe: (() => { const p = politicaPE(a.data.personal_externo); return { status: STATUS_PE[p.status].rotulo, ...prefillTaxa(p), conferido: p.conferido ? dataCurta(p.conferido) : null }; })(),
  };
});
const comPreco = lista.filter((a) => a.planos.length);
const precos = comPreco.flatMap((a) => a.planos.map((p) => p.centavos));
const menor = Math.min(...precos), maior = Math.max(...precos);
// Faixas por tipo de academia, só com planos mensais publicados nas fichas.
const faixa = (ids: string[]) => { const ps = comPreco.filter((a) => ids.some((i) => a.id.startsWith(i))).flatMap((a) => a.planos.map((p) => p.centavos)); return ps.length ? { min: Math.min(...ps), max: Math.max(...ps), nomes: [...new Set(comPreco.filter((a) => ids.some((i) => a.id.startsWith(i))).map((a) => a.nome.replace(/ (Sodimac|Carrefour|Barueri|Parque|Centro|Av\.).*$/, '')))] } : null; };
const TIPOS = [
  { t: 'Academia de rede, de baixo custo', f: faixa(['smart-fit-', 'panobianco-']), obs: 'Musculação e aulas curtas; plano de uma unidade ou da rede toda.' },
  { t: 'Academia grande ou premium', f: faixa(['ironberg-', 'nitrogym-']), obs: 'Área maior, mais horário e serviços; preço sobe sem fidelidade.' },
  { t: 'Box de CrossFit, com aula e coach', f: faixa(['blacksheep-']), obs: 'Treino em turma; o valor é do plano ilimitado.' },
];
const sf = comPreco.filter((a) => a.id.startsWith('smart-fit-')).flatMap((a) => a.planos.map((p) => p.centavos));
const sfMin = Math.min(...sf), sfMax = Math.max(...sf);

// Exemplo com valores fictícios, calculado pela mesma lógica da ferramenta.
const ex: [string, Cenario][] = [
  ['Academia perto do trabalho', { ...cenarioVazio(), acessoValor: '160', freqValor: '8', freqPeriodo: 'mes', transporte: 'valor', transporteModo: 'ida', transporteValor: '10' }],
  ['Academia perto de casa', { ...cenarioVazio(), acessoValor: '210', freqValor: '12', freqPeriodo: 'mes', transporte: 'valor', transporteModo: 'ida', transporteValor: '0' }],
  ['Condomínio com personal', { ...cenarioVazio(), acessoModo: 'incluido', freqValor: '8', freqPeriodo: 'mes', personal: 'valor', personalModo: 'mes', personalValor: '960' }],
];
const exRes = ex.map(([n, c]) => ({ n, r: calcular(c) }));

const titulo = 'Quanto custa treinar em Alphaville? Calculadora';
const descricao = 'Simule quanto custa treinar em Alphaville, Tamboré, Barueri e Santana de Parnaíba: mensalidade, matrícula, estacionamento e personal, por mês e por ida.';
const schema = [{ '@type': 'WebApplication', name: 'Calculadora de custo para treinar em Alphaville', url: new URL(URL_PAG, Astro.site).href, applicationCategory: 'FinanceApplication', operatingSystem: 'Qualquer navegador', inLanguage: 'pt-BR', offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' } }];

const perguntas = [
  { p: 'Quanto custa treinar em Alphaville por mês?', r: `Depende da academia, de quantas vezes você vai e dos custos em volta. Entre os planos mensais publicados nas fichas do guia, a mensalidade vai de ${reais(menor)} a ${reais(maior)}. Some estacionamento, deslocamento e, se for o caso, personal; a calculadora faz essa conta e mostra também o custo por treino.` },
  { p: 'Como a calculadora trata o plano anual pago à vista?', r: 'O valor inteiro aparece no primeiro mês, porque é o que sai do bolso. No mês típico, ele entra dividido pelos meses do plano, e no primeiro ano entra uma vez só. Plano anual cobrado mês a mês, com fidelidade, deve ser informado como mensalidade.' },
  { p: 'A matrícula entra no custo mensal?', r: 'Não. Matrícula e adesão entram no primeiro mês e no primeiro ano, quando são cobradas. O mês típico e o custo por treino mostram só o que se repete todo mês.' },
  { p: 'Como informar o estacionamento?', r: 'Por ida, informe o total de ida e volta de um treino, incluindo estacionamento, combustível ou aplicativo, se quiser. Por mês, informe o valor fechado. Se o estacionamento for grátis, marque o valor zero; se já estiver no plano, escolha "já incluído".' },
  { p: 'Quanto custa personal trainer no condomínio em Alphaville?', r: 'O guia não publica preço de personal, porque o valor muda com a frequência, o formato e o profissional. Informe na calculadora a proposta que você recebeu, por mês ou por aula, e compare com treinar sozinho numa academia.' },
  { p: 'A academia cobra taxa de personal externo?', r: 'Algumas academias cobram uma taxa para o personal de fora atender lá, e outras não aceitam personal externo. Várias fichas do guia já trazem a regra publicada (a Arena 18 e a Ironberg, por exemplo, cobram um valor fixo por mês, pago pelo profissional); nas outras, pergunte na recepção. Quando você escolhe uma academia do guia, a calculadora preenche a regra da ficha. Na calculadora, você informa a taxa e diz se ela já está no valor do personal, para não contar duas vezes.' },
  { p: 'Quanto custa 1 mês de Smart Fit em Alphaville?', r: `Nas unidades da região com ficha no guia, os planos publicados vão de ${reais(sfMin)} a ${reais(sfMax)} por mês, com fidelidade. Sem fidelidade, a rede informa R$ 20 a mais por mês, e algumas unidades cobram adesão. Escolha a unidade na calculadora para preencher o plano.` },
  { p: 'A taxa do condomínio entra na conta?', r: 'Não. Se o seu residencial tem academia, o acesso já está pago na taxa condominial, que você paga treinando ou não. Na calculadora, escolha "academia do condomínio" e some só o que muda por treinar: personal, taxa de personal externo, se o condomínio cobrar, e equipamentos.' },
  { p: 'Quantas vezes por semana usar na simulação?', r: 'Use quantas vezes você consegue ir de verdade, não a meta. O custo por treino muda muito com a frequência: a mesma mensalidade dividida por 8 idas custa o dobro por treino do que dividida por 16. Se a rotina varia, simule as duas frequências em cenários separados.' },
  { p: 'Por que olhar o custo por treino?', r: 'Uma academia mais cara pode sair mais barata por treino se você for mais vezes, e uma barata pode sair cara se o estacionamento for pago a cada ida. O custo por treino divide o mês típico pelo número de idas.' },
];
---
<Base titulo={titulo} semSufixo descricao={descricao} schema={schema} migalhas={[{ nome: 'Ferramentas', url: '/ferramentas/' }, { nome: 'Calculadora de custo', url: URL_PAG }]}>
  <div class="wrap">
    <header class="cab-pag">
      <span class="rotulo cor-marca">Ferramenta</span>
      <h1>Calculadora de custo para treinar em Alphaville</h1>
      <p class="linha-fina">Compare até três opções, como a academia perto de casa, a perto do trabalho e o espaço fitness do condomínio, considerando quantas vezes você realmente vai treinar.</p>
    </header>

    <div class="resposta"><span class="rotulo">Em resumo</span>
      <p>O custo real de treinar é a mensalidade mais o que vem junto: matrícula, estacionamento ou deslocamento e, se houver, personal. Entre os planos mensais publicados nas fichas do guia, a mensalidade vai de {reais(menor)} a {reais(maior)}. Informe sua frequência e veja o primeiro mês, o mês típico, o custo por treino e o primeiro ano de cada opção.</p>
    </div>

    <section class="bloco fino" aria-labelledby="calc-t">
      <h2 id="calc-t" class="so-leitor">Calculadora</h2>
      <div id="calc" class="calc" data-url={URL_PAG}>
        <noscript><p class="caixa">A calculadora precisa de JavaScript. Sem ele, use o exemplo e a tabela de planos publicados abaixo para fazer a conta: mensalidade + estacionamento por ida × idas no mês.</p></noscript>
        <div id="cenarios" class="cen-grade"></div>
        <button type="button" class="add-cen" id="add"><span aria-hidden="true">+</span> Comparar com outra opção</button>
        <p id="limite" class="nota-pq" hidden>Você pode comparar até três opções.</p>
        <section id="resumo" class="resumo" aria-labelledby="resumo-t" hidden>
          <div class="resumo-cab">
            <h3 id="resumo-t">Comparação</h3>
            <div class="seg seg-crit" role="radiogroup" aria-label="Comparar por">
              <button type="button" role="radio" data-crit="mensal" aria-checked="true">Por mês</button>
              <button type="button" role="radio" data-crit="porIda" aria-checked="false">Por treino</button>
              <button type="button" role="radio" data-crit="primeiroMes" aria-checked="false">1º mês</button>
              <button type="button" role="radio" data-crit="ano" aria-checked="false">1º ano</button>
            </div>
          </div>
          <div id="barras" class="barras"></div>
          <p id="resumo-nota" class="nota-pq"></p>
          <details class="resumo-tab"><summary>Ver todos os números lado a lado</summary><div id="resumo-tab"></div></details>
        </section>
        <aside id="cta" class="cta-calc" hidden aria-label="Atendimento com personal">
          <span class="rotulo">Quem mantém este guia · publicidade da casa</span>
          <p>O Montinho Personal Trainer atende presencialmente em Alphaville, Tamboré, Barueri e Santana de Parnaíba, em casa, no condomínio ou em academia que aceite personal externo. O guia não publica preço de personal: use na calculadora o valor da proposta que você receber.</p>
          <p class="cta-botoes">
            <a class="btn" href={linkMontinho('/onde-atendo', 'calculadora', 'custo-para-treinar')} rel="nofollow" data-evento="clique_montinho" data-ref="calculadora-cta">Consultar atendimento presencial na minha região <i aria-hidden="true"></i></a>
            {WHATSAPP && <a class="link-forte" href={linkWhatsapp('calculadora')} rel="nofollow noopener" target="_blank" data-evento="clique_whatsapp" data-ref="calculadora-cta">Conversar no WhatsApp</a>}
          </p>
        </aside>
      </div>
    </section>

    <div class="prosa">
      <h2>Como usar</h2>
      <ol>
        <li>Escolha onde vai treinar: uma academia do guia (busque pelo nome ou bairro), outra academia ou o condomínio. Quando a ficha tem plano publicado, ele entra preenchido, com a fonte e a data; troque pelo valor da cotação que você recebeu.</li>
        <li>Informe quantas vezes vai treinar, por semana ou por mês. Use a frequência real, não a ideal.</li>
        <li>Em "Outros custos", toque em estacionamento, personal, matrícula ou taxa anual para incluir. Se o custo já está no plano, marque "já está incluído".</li>
        <li>Toque em "Comparar com outra opção" para montar até três cenários e escolha se quer comparar por mês, por treino, primeiro mês ou primeiro ano. Nada é enviado nem guardado: a conta é feita no seu aparelho.</li>
      </ol>

      <h2>Como a conta é feita</h2>
      <ul>
        <li><strong>Idas por mês:</strong> frequência semanal × 52 semanas ÷ 12 meses. Quem treina 3 vezes por semana faz 13 idas por mês. Se você informar por mês, vale o número informado.</li>
        <li><strong>Primeiro mês:</strong> o que sai do bolso no começo: primeira mensalidade, matrícula, taxa anual e plano pago à vista.</li>
        <li><strong>Mês típico:</strong> o equivalente mensal do que se repete. Plano à vista e taxa anual entram divididos pelos meses que cobrem; matrícula não entra.</li>
        <li><strong>Custo por treino:</strong> mês típico ÷ idas por mês. Sem frequência, ou com frequência zero, fica indisponível.</li>
        <li><strong>Primeiro ano:</strong> doze meses típicos dos custos recorrentes, mais matrícula e taxa anual uma vez. O plano à vista entra uma vez se cobre 12 meses ou mais; se cobre menos, entra quantas vezes for preciso para fechar o ano (um plano de 6 meses entra duas vezes).</li>
        <li><strong>Campos vazios não viram zero.</strong> Um custo marcado e sem valor aparece como pendente, e o total vira subtotal identificado. Valor zero é zero; "já incluído" não é cobrado de novo.</li>
        <li><strong>Mais barato:</strong> só entram na comparação os cenários completos no critério escolhido.</li>
      </ul>

      <h2>Quanto custa academia em Alphaville, por tipo</h2>
      <p>Faixas dos planos mensais publicados nas fichas do guia, com fidelidade quando a rede exige. Não incluem matrícula, estacionamento nem personal; para isso serve a calculadora acima.</p>
      <ul>
        {TIPOS.filter((x) => x.f).map((x) => <li><strong>{x.t}:</strong> {x.f!.min === x.f!.max ? reais(x.f!.min) : `de ${reais(x.f!.min)} a ${reais(x.f!.max)}`} por mês ({x.f!.nomes.join(', ')}). {x.obs}</li>)}
        <li><strong>Wellness club e estúdios:</strong> SIX, estúdios de pilates, yoga e funcional não publicam mensalidade nas fontes conferidas. Nos agregadores, os estúdios costumam pedir planos a partir do Gold do Wellhub ou do TP 4 do TotalPass; veja <a href="/academias/wellhub-totalpass/">Wellhub e TotalPass</a>.</li>
      </ul>

      <h2>Exemplo de simulação</h2>
      <p><em>Valores fictícios, só para mostrar a conta. Não são preços de academias nem de personal da região.</em></p>
    </div>
    <div class="rolagem" tabindex="0" role="region" aria-label="Exemplo de simulação">
      <table class="dados">
        <caption>Simulação com valores fictícios.</caption>
        <thead><tr><th scope="col">Cenário</th><th scope="col">Composição</th><th scope="col">Mês típico</th><th scope="col">Por treino</th></tr></thead>
        <tbody>
          <tr><th scope="row">{exRes[0].n}</th><td>Mensalidade de R$ 160 + estacionamento de R$ 10 por ida × 8 idas</td><td>{reais(exRes[0].r.mensal!)}</td><td>{reais(exRes[0].r.porIda!)}</td></tr>
          <tr><th scope="row">{exRes[1].n}</th><td>Mensalidade de R$ 210, estacionamento grátis, 12 idas</td><td>{reais(exRes[1].r.mensal!)}</td><td>{reais(exRes[1].r.porIda!)}</td></tr>
          <tr><th scope="row">{exRes[2].n}</th><td>Acesso já incluído + personal de R$ 960 por mês, 8 idas</td><td>{reais(exRes[2].r.mensal!)}</td><td>{reais(exRes[2].r.porIda!)}</td></tr>
        </tbody>
      </table>
    </div>
    <div class="prosa">
      <p>O terceiro cenário é o mais caro porque inclui acompanhamento profissional, que os outros dois não têm. Compare totais sabendo o que cada um entrega. <a href={`${URL_PAG}?exemplo=1`}>Abrir este exemplo na calculadora</a>.</p>

      <h2>Planos publicados que a calculadora usa</h2>
      <p>Só estas unidades publicam mensalidade em fonte oficial conferida pelo guia. Nas demais, a calculadora traz o nome e a ficha, e o valor fica para você informar. Diárias, pacotes e aulas avulsas não entram.</p>
    </div>
    <div class="rolagem" tabindex="0" role="region" aria-label="Planos publicados">
      <table class="dados">
        <caption>Planos mensais das fichas, com a fonte e a data de conferência. Condições podem ter mudado; confirme na academia.</caption>
        <thead><tr><th scope="col">Academia</th><th scope="col">Plano</th><th scope="col">Valor</th><th scope="col">Condições</th><th scope="col">Fonte</th></tr></thead>
        <tbody>
          {comPreco.flatMap((a) => a.planos.map((p, i) => (
            <tr>
              <th scope="row">{i === 0 ? <a href={a.url}>{a.nome}</a> : ''}</th>
              <td>{p.nome}</td><td>{reais(p.centavos)}/mês</td><td>{p.condicoes}</td>
              <td>{i === 0 ? <><a href={a.fonteUrl!} rel="nofollow noopener" target="_blank">{a.fonte}</a>, {a.conferido}{a.abrangencia === 'rede' ? ' (preço da rede)' : ''}</> : ''}</td>
            </tr>
          )))}
        </tbody>
      </table>
    </div>
    <div class="prosa">
      <p>Para ver preços com mais contexto, leia <a href="/academias/precos/">quanto custa academia em Alphaville e Barueri</a>. Para comparar horário e estrutura antes do custo, use o <a href="/ferramentas/comparador/">comparador</a>; se a dúvida é treinar sozinho ou com acompanhamento, leia <a href="/guias/academia-ou-personal/">academia ou personal trainer</a>. Quem usa agregador encontra o plano mínimo de cada academia em <a href="/academias/wellhub-totalpass/">Wellhub e TotalPass</a>.</p>
    </div>

    <VideoApp pagina="calculadora" />
    <Perguntas itens={perguntas} titulo="Dúvidas que mudam a conta" />
    <LeiaTambem url={URL_PAG} />
  </div>

  <script type="application/json" id="calc-dados" set:html={JSON.stringify(lista)}></script>
  <script>
    import { calcular, cenarioVazio, maisBarato, reais, CRITERIOS, type Cenario, type Criterio, type Resultado, type Situacao } from '../../lib/custo';

    type Plano = { nome: string; centavos: number; inicial: number | null; condicoes: string; mesGratis: boolean };
    type Acad = { id: string; nome: string; bairro: string; regiaoNome: string; url: string; planos: Plano[]; fonte: string | null; fonteUrl: string | null; conferido: string; abrangencia: string | null; estacionamento: string[]; ags: { nome: string; plano_minimo: string; preco_plano: string }[]; pe: { status: string; taxaExterno: 'nao' | 'valor' | 'pendente'; taxaExternoModo?: 'mes' | 'aula' | 'ida'; taxaExternoValor?: string; nota: string; conferido: string | null } };
    type Tipo = '' | 'guia' | 'manual' | 'condominio';
    type Item = { tipo: Tipo; acad: string; plano: string; busca: string; c: Cenario; beneficio?: string };

    const ACADS: Acad[] = JSON.parse(document.getElementById('calc-dados')!.textContent!);
    const porId = (id: string) => ACADS.find((a) => a.id === id);
    const raiz = document.getElementById('calc')!;
    const box = document.getElementById('cenarios')!;
    const ev = (n: string, d: Record<string, string | number> = {}) => { const w = window as any; if (typeof w.otaEvento === 'function') w.otaEvento(n, d); };
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const sem = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const centParaTxt = (c: number) => (c / 100).toFixed(2).replace('.', ',').replace(/,00$/, '');
    const COM_PRECO = ACADS.filter((a) => a.planos.length);

    let itens: Item[] = [];
    const pronto = (it: Item) => !!it.tipo && !(it.tipo === 'guia' && !it.acad);
    let criterio: Criterio = 'mensal';

    const novo = (): Item => ({ tipo: '', acad: '', plano: '', busca: '', c: cenarioVazio() });
    function escolherTipo(it: Item, tipo: Tipo) {
      const freq = { freqValor: it.c.freqValor, freqPeriodo: it.c.freqPeriodo };
      it.tipo = tipo; it.acad = ''; it.plano = ''; it.busca = '';
      it.c = { ...cenarioVazio(), ...freq };
      if (tipo === 'condominio') { it.c.nome = 'Academia do condomínio'; it.c.acessoModo = 'incluido'; }
    }
    function escolherAcad(it: Item, id: string) {
      const a = porId(id); if (!a) return;
      it.tipo = 'guia'; it.acad = id; it.busca = ''; it.c.nome = a.nome; it.plano = '';
      it.c.acessoModo = 'mensal'; it.c.acessoValor = ''; it.c.inicial = 'nao'; it.c.inicialValor = '';
      if (a.planos.length) escolherPlano(it, '0');
    }
    // Política de personal externo da ficha: só preenche taxa confirmada e paga pelo aluno; o resto fica pendente ou fora.
    function aplicarPE(it: Item) {
      const pe = porId(it.acad)?.pe; if (!pe) return;
      it.c.taxaExterno = pe.taxaExterno;
      if (pe.taxaExternoModo) it.c.taxaExternoModo = pe.taxaExternoModo;
      it.c.taxaExternoValor = pe.taxaExternoValor ?? '';
    }
    function escolherPlano(it: Item, idx: string) {
      const p = porId(it.acad)?.planos[Number(idx)]; if (!p) return;
      it.plano = idx; it.c.acessoModo = 'mensal'; it.c.acessoValor = centParaTxt(p.centavos); it.c.mesGratis = p.mesGratis;
      if (p.inicial !== null) { it.c.inicial = 'valor'; it.c.inicialValor = centParaTxt(p.inicial); } else { it.c.inicial = 'nao'; it.c.inicialValor = ''; }
    }

    // ---------- peças de interface ----------
    const seg = (k: string, opts: [string, string][], v: string, rot: string, i: number) =>
      `<div class="seg" role="radiogroup" aria-label="${rot}">${opts.map(([val, t]) => `<button type="button" role="radio" data-k="${k}" data-v="${val}" aria-checked="${val === v}" id="c${i}-${k}-${val}">${t}</button>`).join('')}</div>`;
    const dinheiro = (k: string, v: string, rot: string, i: number, dica = '') =>
      `<label class="campo-v" data-campo="${k}"><span class="rot">${rot}</span><span class="moeda"><span aria-hidden="true">R$</span><input type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" data-k="${k}" id="c${i}-${k}" value="${esc(v)}"${dica ? ` aria-describedby="c${i}-${k}-d"` : ''}></span>${dica ? `<small class="dica" id="c${i}-${k}-d">${dica}</small>` : ''}<small class="erro" id="c${i}-${k}-e" role="alert"></small></label>`;
    const numero = (k: string, v: string, rot: string, i: number, dica = '') =>
      `<label class="campo-v" data-campo="${k}"><span class="rot">${rot}</span><span class="contador"><button type="button" data-passo="${k}" data-d="-1" aria-label="Menos">−</button><input type="text" inputmode="decimal" autocomplete="off" data-k="${k}" id="c${i}-${k}" value="${esc(v)}"${dica ? ` aria-describedby="c${i}-${k}-d"` : ''}><button type="button" data-passo="${k}" data-d="1" aria-label="Mais">+</button></span>${dica ? `<small class="dica" id="c${i}-${k}-d">${dica}</small>` : ''}<small class="erro" id="c${i}-${k}-e" role="alert"></small></label>`;

    const EXTRAS: { k: 'inicial' | 'transporte' | 'personal' | 'anual'; t: string }[] = [
      { k: 'transporte', t: 'Estacionamento' }, { k: 'personal', t: 'Personal' }, { k: 'inicial', t: 'Matrícula' }, { k: 'anual', t: 'Taxa anual' },
    ];

    function blocoLocal(it: Item, i: number): string {
      const tipos = `<div class="seg seg-tipo" role="radiogroup" aria-label="Onde você vai treinar">
        ${([['guia', 'Academia do guia'], ['manual', 'Outra academia'], ['condominio', 'Condomínio']] as [Tipo, string][]).map(([v, t]) => `<button type="button" role="radio" data-tipo="${v}" aria-checked="${it.tipo === v}" id="c${i}-tipo-${v}">${t}</button>`).join('')}
      </div>`;
      if (it.tipo === 'guia' && !it.acad) {
        return `${tipos}<div class="busca-ac"><label class="so-leitor" for="c${i}-busca">Buscar academia</label>
          <input type="search" id="c${i}-busca" data-busca placeholder="Busque pelo nome ou pelo bairro" autocomplete="off" value="${esc(it.busca)}" aria-controls="c${i}-lista">
          <ul class="ac-lista" id="c${i}-lista">${listaAcad(it.busca)}</ul></div>`;
      }
      if (it.tipo === 'guia' && it.acad) {
        const a = porId(it.acad)!;
        const p = a.planos[Number(it.plano)];
        let h = `${tipos}<div class="escolhida"><div><strong>${esc(a.nome)}</strong><span>${esc(a.bairro)} · ${esc(a.regiaoNome)}</span></div><button type="button" class="btn-txt" data-acao="trocar">Trocar</button></div>`;
        const ag = it.beneficio ? a.ags.find((g) => g.nome.toLowerCase() === it.beneficio) : undefined;
        if (it.beneficio) {
          h += `<p class="fonte pe-calc"><strong>Acesso pelo ${esc(ag?.nome ?? it.beneficio)}.</strong> Informe abaixo quanto você paga pelo benefício; a mensalidade direta da academia não entra, para não contar o acesso duas vezes.${ag ? ` Referência: a unidade entra a partir do ${esc(ag.plano_minimo)}, de ${esc(ag.preco_plano)} por mês na tabela do benefício; o valor da sua empresa pode ser outro.` : ''} <button type="button" class="btn-txt" data-acao="sem-beneficio">Usar mensalidade direta</button></p>`;
        } else if (a.planos.length) {
          h += `<fieldset class="planos"><legend>Plano publicado</legend>${a.planos.map((pl, j) => `<button type="button" class="plano" data-plano="${j}" aria-pressed="${String(j) === it.plano}"><span>${esc(pl.nome)}</span><strong>${reais(pl.centavos)}<small>/mês</small></strong></button>`).join('')}</fieldset>
            <p class="fonte">${p ? `${esc(p.condicoes)} ` : ''}Fonte: <a href="${a.fonteUrl}" target="_blank" rel="nofollow noopener">${esc(a.fonte!)}</a>, ${a.conferido}${a.abrangencia === 'rede' ? ', preço da rede' : ''}. Recebeu outro valor? Edite abaixo.</p>`;
        } else h += `<p class="fonte">Esta academia não publica mensalidade. Informe abaixo o valor que ela passar para você.</p>`;
        if (a.estacionamento.length) { const det = a.estacionamento.filter((x) => !/^estacionamento$/i.test(x.trim())); h += `<p class="fonte">${det.length ? `Estacionamento, segundo a ficha: ${esc(det.join('; '))}.` : 'A ficha informa que há estacionamento, sem valor publicado.'}</p>`; }
        return h + `<p class="fonte"><a href="${a.url}">Ver a ficha da ${esc(a.nome)}</a></p>`;
      }
      if (it.tipo === 'manual') return `${tipos}<label class="campo-v"><span class="rot">Nome da academia</span><input type="text" data-k="nome" id="c${i}-nome" value="${esc(it.c.nome)}" autocomplete="off" placeholder="Ex.: academia perto do trabalho"></label>`;
      if (it.tipo === 'condominio') return `${tipos}<p class="fonte">O acesso já está pago na taxa do condomínio. Some abaixo só o que muda por treinar, como personal.</p>`;
      return tipos;
    }

    function listaAcad(q: string): string {
      const t = sem(q.trim());
      const xs = t ? ACADS.filter((a) => sem(`${a.nome} ${a.bairro} ${a.regiaoNome}`).includes(t)).slice(0, 8) : COM_PRECO;
      const cab = t ? '' : `<li class="ac-cab">Com preço publicado · digite para ver as ${ACADS.length} academias</li>`;
      if (!xs.length) return `<li class="ac-vazio">Nenhuma academia encontrada. Use "Outra academia".</li>`;
      return cab + xs.map((a) => `<li><button type="button" data-acad="${a.id}"><strong>${esc(a.nome)}</strong><span>${esc(a.bairro)} · ${esc(a.regiaoNome)}</span>${a.planos.length ? `<em>a partir de ${reais(Math.min(...a.planos.map((p) => p.centavos)))}</em>` : ''}</button></li>`).join('');
    }

    function peNota(it: Item): string {
      const pe = porId(it.acad)?.pe; if (!pe) return '';
      return `<p class="fonte pe-calc"><strong>${esc(pe.status)}.</strong> ${esc(pe.nota)}${pe.conferido ? ` Verificado em ${pe.conferido}.` : ''}</p>`;
    }
    function blocoExtras(c: Cenario, i: number, it: Item): string {
      const chips = `<div class="chips">${EXTRAS.map((x) => `<button type="button" class="chip" data-extra="${x.k}" aria-pressed="${c[x.k] !== 'nao'}">${c[x.k] !== 'nao' ? '✓' : '+'} ${x.t}</button>`).join('')}</div>`;
      const caixa = (k: string, titulo: string, corpo: string) => `<div class="extra" data-bloco="${k}"><div class="extra-cab"><strong>${titulo}</strong><button type="button" class="btn-txt" data-extra-sai="${k}" aria-label="Remover ${titulo}">Remover</button></div>${corpo}</div>`;
      const sit = (k: string, s: Situacao, rot: string) => seg(k, [['valor', 'Tenho um valor'], ['incluido', 'Já está incluído']], s, rot, i);
      let h = '';
      if (c.transporte !== 'nao') h += caixa('transporte', 'Estacionamento e deslocamento', `${sit('transporte', c.transporte, 'Estacionamento')}${c.transporte === 'valor' ? `${seg('transporteModo', [['ida', 'Por ida'], ['mes', 'Por mês']], c.transporteModo, 'Cobrança', i)}${dinheiro('transporteValor', c.transporteValor, c.transporteModo === 'ida' ? 'Valor por ida (ida e volta)' : 'Valor por mês', i, c.transporteModo === 'ida' ? 'Some estacionamento, combustível ou aplicativo de um treino. Grátis? Digite 0.' : '')}` : ''}`);
      if (c.personal !== 'nao') h += caixa('personal', 'Personal trainer', `${sit('personal', c.personal, 'Personal')}${c.personal === 'valor' ? `${seg('personalModo', [['mes', 'Por mês'], ['aula', 'Por aula']], c.personalModo, 'Cobrança do personal', i)}${dinheiro('personalValor', c.personalValor, c.personalModo === 'aula' ? 'Valor por aula' : 'Valor por mês', i)}` : ''}
        ${c.personal === 'valor' && c.personalModo === 'aula' || c.taxaExterno !== 'nao' && c.taxaExternoModo === 'aula' ? `<div class="linha2">${numero('personalAulas', c.personalAulas, 'Aulas com personal', i, 'Pode ser menos que o total de idas.')}${seg('personalAulasPeriodo', [['semana', 'por semana'], ['mes', 'por mês']], c.personalAulasPeriodo, 'Período das aulas', i)}</div>` : ''}
        <p class="rot-q">A academia cobra taxa para personal de fora?</p>
        ${peNota(it)}
        ${seg('taxaExterno', [['nao', 'Não, ou paga o personal'], ['valor', 'Sim, eu pago'], ['incluido', 'Já no valor do personal'], ['pendente', 'Não sei']], c.taxaExterno, 'Taxa de personal externo', i)}
        ${c.taxaExterno === 'valor' ? `${seg('taxaExternoModo', [['mes', 'Por mês'], ['aula', 'Por aula'], ['ida', 'Por ida']], c.taxaExternoModo, 'Cobrança da taxa', i)}${dinheiro('taxaExternoValor', c.taxaExternoValor, 'Valor da taxa', i)}` : ''}
        <p class="fonte"><a href="/ferramentas/academias-que-aceitam-personal-externo/" data-evento="clique_guia_personal_externo" data-ref="calculadora">Ver academias que aceitam personal externo</a></p>`);
      if (c.inicial !== 'nao') h += caixa('inicial', 'Matrícula ou adesão', `${sit('inicial', c.inicial, 'Matrícula')}${c.inicial === 'valor' ? dinheiro('inicialValor', c.inicialValor, 'Valor cobrado uma vez', i, 'Entra só no primeiro mês e no ano. Isenta? Digite 0.') : ''}`);
      if (c.anual !== 'nao') h += caixa('anual', 'Taxa anual', `${sit('anual', c.anual, 'Taxa anual')}${c.anual === 'valor' ? dinheiro('anualValor', c.anualValor, 'Valor por ano', i, 'Cobrada no primeiro mês; no mês típico entra 1/12.') : ''}`);
      return chips + h;
    }

    function cartao(it: Item, i: number): string {
      const c = it.c;
      const titulo = it.tipo ? (c.nome || (it.tipo === 'manual' ? 'Outra academia' : 'Escolha a academia')) : 'Onde você vai treinar?';
      return `<article class="cen" data-i="${i}" aria-labelledby="c${i}-t">
        <header class="cen-cab"><span class="num" aria-hidden="true">${i + 1}</span><h3 id="c${i}-t"><span class="so-leitor">Opção ${i + 1}: </span>${esc(titulo)}</h3>${itens.length > 1 ? `<button type="button" class="fechar" data-remover="${i}" aria-label="Remover opção ${i + 1}">×</button>` : ''}</header>
        <div class="etapa">${blocoLocal(it, i)}</div>
        ${it.tipo && !(it.tipo === 'guia' && !it.acad) ? `
        <div class="etapa"><p class="rot-q">Como você paga o acesso?</p>
          ${it.tipo === 'condominio' ? '' : `${seg('acessoModo', [['mensal', 'Mensalidade'], ['avista', 'À vista'], ['incluido', 'Já incluído']], c.acessoModo, 'Forma de pagamento', i)}`}
          ${c.acessoModo === 'incluido' ? '' : `<div class="linha2">${dinheiro('acessoValor', c.acessoValor, it.beneficio ? 'Quanto você paga pelo benefício, por mês' : c.acessoModo === 'avista' ? 'Valor total pago' : 'Mensalidade', i)}${c.acessoModo === 'avista' ? numero('avistaMeses', c.avistaMeses, 'Meses do plano', i) : ''}</div>`}
        </div>
        <div class="etapa"><p class="rot-q">Quantas vezes você vai treinar de verdade?</p>
          <div class="linha2">${numero('freqValor', c.freqValor, 'Treinos', i)}${seg('freqPeriodo', [['semana', 'por semana'], ['mes', 'por mês']], c.freqPeriodo, 'Período', i)}</div>
        </div>
        <div class="etapa"><p class="rot-q">Outros custos</p>${blocoExtras(c, i, it)}</div>
        <div class="res" id="c${i}-res" aria-live="polite"></div>` : ''}
      </article>`;
    }

    const EST: Record<string, string> = { zero: 'zero', incluido: 'incluído', pendente: 'pendente' };
    function resultadoHTML(r: Resultado): string {
      const v = (x: number | null, parcial: number) => x !== null ? reais(x) : parcial > 0 ? `<span class="pendv">${reais(parcial)} + ?</span>` : '<span class="pendv">—</span>';
      const comp = r.componentes.map((x) => `<li><span>${esc(x.rotulo)}</span><b>${x.estado === 'ok' ? (x.mensal !== null && x.mensal !== x.primeiroMes ? `${reais(x.primeiroMes ?? 0)} → ${reais(x.mensal)}/mês` : `${reais(x.mensal || x.primeiroMes || 0)}`) : EST[x.estado]}</b>${x.nota ? `<small>${esc(x.nota)}</small>` : ''}</li>`).join('');
      return `<div class="res-topo">
          <div class="res-hero"><span>Por mês</span><strong>${v(r.mensal, r.parcial.mensal)}</strong></div>
          <div class="res-hero"><span>Por treino</span><strong>${r.porIda !== null ? reais(r.porIda) : '<span class="pendv">—</span>'}</strong></div>
        </div>
        <div class="res-sec"><div><span>1º mês</span><b>${v(r.primeiroMes, r.parcial.primeiroMes)}</b></div><div><span>1º ano</span><b>${v(r.ano, r.parcial.ano)}</b></div></div>
        <p class="res-prem">${esc(r.premissaIdas)}</p>
        ${r.erros.length ? `<p class="res-alerta">${r.erros.map((e) => esc(e.msg)).join(' ')}</p>` : r.pendencias.length ? `<p class="res-alerta">Falta: ${r.pendencias.map(esc).join(', ')}.${r.porIda === null && r.motivoPorIda && !r.pendencias.length ? ' ' + esc(r.motivoPorIda) : ''}</p>` : r.porIda === null && r.motivoPorIda ? `<p class="res-alerta">${esc(r.motivoPorIda)}</p>` : ''}
        ${r.componentes.length ? `<details class="res-comp"${r.temPersonal ? ' open' : ''}><summary>O que entrou na conta${r.temPersonal ? ' · inclui personal' : ''}</summary><ul>${comp}</ul></details>` : ''}`;
    }

    // ---------- atualização ----------
    let jaSimulou = false, jaComparou = false;
    function atualizar() {
      const rs = itens.map((it) => calcular(it.c));
      rs.forEach((r, i) => {
        const el = box.querySelector<HTMLElement>(`[data-i="${i}"]`); if (!el || !pronto(itens[i])) return;
        const res = el.querySelector(`#c${i}-res`); if (res) res.innerHTML = resultadoHTML(r);
        el.querySelectorAll<HTMLInputElement>('input[data-k]').forEach((inp) => {
          const e = r.erros.find((x) => x.campo === inp.dataset.k);
          inp.setAttribute('aria-invalid', e ? 'true' : 'false');
          const m = el.querySelector(`#c${i}-${inp.dataset.k}-e`); if (m) m.textContent = e ? e.msg : '';
        });
      });
      const prontos = itens.filter(pronto).length;
      const resumo = document.getElementById('resumo')!;
      resumo.hidden = prontos < 2;
      if (prontos >= 2) {
        const mb = maisBarato(rs.map((r, i) => (pronto(itens[i]) ? r : { ...r, [criterio]: null } as Resultado)), criterio);
        const vals = rs.map((r, i) => (pronto(itens[i]) ? r[criterio] : null));
        const max = Math.max(1, ...vals.filter((x): x is number => x !== null));
        document.getElementById('barras')!.innerHTML = itens.map((it, i) => !pronto(it) ? '' : `<div class="barra${mb.indices.includes(i) ? ' melhor' : ''}">
            <div class="barra-rot"><strong>${esc(it.c.nome || `Opção ${i + 1}`)}</strong>${rs[i].temPersonal ? '<span class="tag">com personal</span>' : ''}${mb.indices.includes(i) ? '<span class="tag tag-ok">mais barato</span>' : ''}</div>
            <div class="barra-trilho" title="${esc(it.c.nome || `Opção ${i + 1}`)}: ${vals[i] !== null ? reais(vals[i]!) : 'pendente'}">${vals[i] !== null ? `<span class="barra-f" style="width:${Math.max(3, (vals[i]! / max) * 100)}%"></span>` : ''}</div>
            <div class="barra-v">${vals[i] !== null ? reais(vals[i]!) : '<span class="pendv">pendente</span>'}</div>
          </div>`).join('');
        const linhas: [Criterio, string][] = [['mensal', 'Por mês'], ['porIda', 'Por treino'], ['primeiroMes', '1º mês'], ['ano', '1º ano']];
        const vis = itens.map((it, i) => ({ it, i })).filter((x) => pronto(x.it));
        document.getElementById('resumo-tab')!.innerHTML = `<table class="tab-cmp"><thead><tr><th scope="col"><span class="so-leitor">Valor</span></th>${vis.map(({ it, i }) => `<th scope="col">${esc(it.c.nome || `Opção ${i + 1}`)}</th>`).join('')}</tr></thead><tbody>${linhas.map(([k, rot]) => `<tr><th scope="row">${rot}</th>${vis.map(({ i }) => `<td>${rs[i][k] !== null ? reais(rs[i][k]!) : '—'}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
        document.getElementById('resumo-nota')!.textContent = mb.indices.length
          ? `Comparando ${CRITERIOS[criterio]} entre ${mb.comparados} opções completas.${rs.some((r, i) => pronto(itens[i]) && r.temPersonal) && rs.some((r, i) => pronto(itens[i]) && !r.temPersonal) ? ' Atenção: uma opção inclui personal e outra não.' : ''}`
          : `Complete o valor em pelo menos duas opções para ver a mais barata no ${CRITERIOS[criterio]}.`;
        if (!jaComparou && rs.filter((r, i) => pronto(itens[i]) && r.mensal !== null && r.idasMes).length >= 2) { jaComparou = true; ev('calculadora_comparacao', { cenarios: prontos }); }
      }
      document.getElementById('cta')!.hidden = !itens.some((it) => it.c.personal !== 'nao');
      if (!jaSimulou && rs.some((r, i) => pronto(itens[i]) && r.mensal !== null && r.idasMes)) { jaSimulou = true; ev('calculadora_simulacao', { cenarios: prontos }); }
      (document.getElementById('add') as HTMLButtonElement).hidden = itens.length >= 3;
      document.getElementById('limite')!.hidden = itens.length < 3;
      const q = new URLSearchParams(); itens.forEach((it, i) => { if (it.acad) q.set('abc'[i], it.acad); });
      // Mantém na URL os pedidos de entrada que ainda valem, para recarregar ou compartilhar sem perder o cenário.
      if (exemploIntacto) q.set('exemplo', '1');
      if (itens.some((it) => it.c.personal !== 'nao')) q.set('personal', '1');
      const benAtivo = itens.find((it) => it.beneficio)?.beneficio; if (benAtivo) q.set('beneficio', benAtivo);
      history.replaceState(null, '', q.toString() ? `?${q}` : location.pathname);
    }

    function desenhar(i?: number, foco?: string) {
      if (i === undefined) box.innerHTML = itens.map(cartao).join('');
      else { const el = box.querySelector(`[data-i="${i}"]`); if (el) el.outerHTML = cartao(itens[i], i); }
      atualizar();
      if (foco) document.getElementById(foco)?.focus();
    }

    // ---------- eventos ----------
    box.addEventListener('input', (e) => {
      exemploIntacto = false;
      const t = e.target as HTMLInputElement; const el = t.closest<HTMLElement>('[data-i]'); if (!el) return;
      const i = Number(el.dataset.i), it = itens[i];
      if (t.hasAttribute('data-busca')) { it.busca = t.value; el.querySelector('.ac-lista')!.innerHTML = listaAcad(t.value); return; }
      if (!t.dataset.k) return;
      (it.c as any)[t.dataset.k] = t.value;
      if (t.dataset.k === 'acessoValor') it.c.mesGratis = false;
      if (t.dataset.k === 'nome') { const h = el.querySelector('h3'); if (h) h.lastChild!.textContent = t.value || 'Outra academia'; }
      atualizar();
    });
    box.addEventListener('keydown', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.hasAttribute('data-busca') && e.key === 'Enter') { e.preventDefault(); (t.closest('.busca-ac')!.querySelector('[data-acad]') as HTMLButtonElement | null)?.click(); }
    });
    box.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return;
      exemploIntacto = false;
      const el = b.closest<HTMLElement>('[data-i]'); if (!el) return;
      const i = Number(el.dataset.i), it = itens[i];
      if (b.dataset.remover !== undefined) { itens.splice(i, 1); desenhar(undefined, 'add'); return; }
      if (b.dataset.tipo) { escolherTipo(it, b.dataset.tipo as Tipo); desenhar(i, b.dataset.tipo === 'guia' ? `c${i}-busca` : b.dataset.tipo === 'manual' ? `c${i}-nome` : `c${i}-tipo-${b.dataset.tipo}`); return; }
      if (b.dataset.acad) { escolherAcad(it, b.dataset.acad); desenhar(i, `c${i}-freqValor`); return; }
      if (b.dataset.acao === 'sem-beneficio') { it.beneficio = undefined; escolherAcad(it, it.acad); desenhar(i, `c${i}-acessoValor`); return; }
      if (b.dataset.acao === 'trocar') { it.acad = ''; it.plano = ''; it.beneficio = undefined; it.c.nome = ''; desenhar(i, `c${i}-busca`); return; }
      if (b.dataset.plano !== undefined) { escolherPlano(it, b.dataset.plano); desenhar(i, `c${i}-acessoValor`); return; }
      if (b.dataset.extra) { const k = b.dataset.extra as 'inicial' | 'transporte' | 'personal' | 'anual'; it.c[k] = it.c[k] === 'nao' ? 'valor' : 'nao'; if (k === 'personal' && it.c.personal !== 'nao') aplicarPE(it); desenhar(i, it.c[k] === 'nao' ? undefined : `c${i}-${k}Valor`); return; }
      if (b.dataset.extraSai) { (it.c as any)[b.dataset.extraSai] = 'nao'; desenhar(i); return; }
      if (b.dataset.passo) {
        const k = b.dataset.passo; const atual = parseFloat(String((it.c as any)[k] || '0').replace(',', '.')) || 0;
        (it.c as any)[k] = String(Math.max(0, atual + Number(b.dataset.d))).replace('.', ','); const inp = el.querySelector<HTMLInputElement>(`#c${i}-${k}`); if (inp) inp.value = (it.c as any)[k];
        atualizar(); return;
      }
      if (b.dataset.k && b.dataset.v !== undefined) { (it.c as any)[b.dataset.k] = b.dataset.v; desenhar(i, b.id); return; }
    });
    document.getElementById('add')!.addEventListener('click', () => { exemploIntacto = false; if (itens.length < 3) { itens.push(novo()); desenhar(undefined, `c${itens.length - 1}-tipo-guia`); } });
