---
import Base from '../../layouts/Base.astro';
import Selo from '../../components/Selo.astro';
import Assinatura from '../../components/Assinatura.astro';
import Fontes from '../../components/Fontes.astro';
import Mantem from '../../components/Mantem.astro';
import Vitrine from '../../components/Vitrine.astro';
import Perguntas from '../../components/Perguntas.astro';
import { Image } from 'astro:assets';
import fotoIbRemada from '../../assets/montinho/montinho-ironberg-remada-maquina.jpg';
import fotoVfRosca from '../../assets/montinho/montinho-voifit-rosca-halteres.jpg';
import fotoVfHalteres from '../../assets/montinho/montinho-voifit-halteres-sala.jpg';
import fotoVfRemada from '../../assets/montinho/montinho-voifit-remada-halteres.jpg';
import fotoVfVestiario from '../../assets/montinho/montinho-voifit-vestiario.jpg';
import fotoVfVestiarioBone from '../../assets/montinho/montinho-voifit-vestiario-bone.jpg';
import fotoIbParalelas from '../../assets/montinho/montinho-ironberg-abdominal-paralelas.jpg';
import fotoIbEspelho from '../../assets/montinho/montinho-ironberg-espelho.jpg';
import fotoIbFones from '../../assets/montinho/montinho-ironberg-abdominal-fones.jpg';
import fotoIbCostas from '../../assets/montinho/montinho-ironberg-costas.jpg';
import fotoArena18 from '../../assets/montinho/montinho-personal-trainer-arena-18.jpg';
// Fotos tiradas pelo próprio Montinho dentro da academia (nunca fotos do site, do Google ou do Instagram da academia).
const FOTO_MONTINHO: Record<string, { fotos: { src: typeof fotoArena18; alt: string }[]; legenda: string }> = {
  'arena-18-alphaville': { fotos: [{ src: fotoArena18, alt: 'Montinho, personal trainer, em selfie no espelho da sala de musculação da Arena 18, em Alphaville' }], legenda: 'O Montinho na Arena 18, onde atende alunos. Publicidade da casa.' },
  'ironberg-alphaville': {
    fotos: [
      { src: fotoIbParalelas, alt: 'Montinho fazendo elevação de pernas no aparelho vermelho de paralelas da Ironberg, com o painel de luz em X no teto' },
      { src: fotoIbEspelho, alt: 'Montinho em frente aos espelhos da área de treino da Ironberg, com paredes de bloco preto e piso claro' },
      { src: fotoIbFones, alt: 'Montinho de fone de ouvido no aparelho de elevação de pernas da Ironberg, com o logo da academia na parede de vidro' },
      { src: fotoIbCostas, alt: 'Montinho de costas, em pose de duplo bíceps diante do espelho da Ironberg' },
      { src: fotoIbRemada, alt: 'Montinho na máquina de remada vermelha da Ironberg, sob o teto com luzes em X e faixas de LED rosa' },
    ],
    legenda: 'O Montinho treinando na Ironberg. Fotos dele, tiradas na academia. Publicidade da casa.',
  },
  'voifit-alphaville': {
    fotos: [
      { src: fotoVfRosca, alt: 'Montinho fazendo rosca com halteres na frente do suporte de halteres da VoiFit, com parede roxa e esteiras ao fundo' },
      { src: fotoVfRemada, alt: 'Montinho fazendo remada unilateral com halter apoiado no suporte da área de pesos livres da VoiFit' },
      { src: fotoVfHalteres, alt: 'Montinho segurando um par de halteres na sala de musculação da VoiFit, com aparelhos e janelas ao fundo' },
      { src: fotoVfVestiario, alt: 'Montinho sorrindo diante do espelho do vestiário da VoiFit, com boxes de chuveiro ao fundo' },
      { src: fotoVfVestiarioBone, alt: 'Montinho de boné diante do espelho do vestiário da VoiFit' },
    ],
    legenda: 'O Montinho treinando na VoiFit. Fotos dele, tiradas na academia. Publicidade da casa.',
  },
};
import { ARTIGOS, COMPARATIVOS, personalDaRegiao } from '../../lib/artigos';
import { abreDomingo, guias } from '../../lib/dados';
import { politicaPE, respostasPE, STATUS_PE } from '../../lib/personal';
import { e24hTodos } from '../../lib/horarios';
import { academias, REGIOES, MODALIDADES, TIPOS, DIAS, DIAS_NOME, faixasDia, horarioResumo, e24h, conferidoEm, dataCurta, dataLonga, dataIso, nivelVerificacao, urlAcademia, urlRegiao, type Academia } from '../../lib/dados';

export async function getStaticPaths() {
  const todas = await academias();
  return todas.map((a) => ({ params: { id: a.id }, props: { a, todas } }));
}
const { a, todas } = Astro.props as { a: Academia; todas: Academia[] };
const d = a.data;
const regiao = REGIOES[d.regiao];
const temPersonal = (await guias()).some((x) => x.id === `personal-trainer-${a.id}`);
const guiasRel = [COMPARATIVOS[a.id] ?? (d.tipo === 'box' ? '/modalidades/crossfit/' : d.modalidades.includes('musculacao') ? '/modalidades/musculacao/' : null), personalDaRegiao(d.regiao, d.bairro), e24h(d.horario) ? '/ferramentas/academias-abertas-alphaville/' : null, abreDomingo(d.horario) ? '/ferramentas/academias-abertas-alphaville/' : null, d.mensalidade ? '/academias/precos/' : null, d.agregadores.length ? '/academias/wellhub-totalpass/' : null].filter((u): u is string => !!u && !!ARTIGOS[u]).slice(0, 4);
const vizinhas = todas.filter((o) => o.id !== a.id && o.data.regiao === d.regiao).sort((x, y) => Number(y.data.bairro === d.bairro) - Number(x.data.bairro === d.bairro)).slice(0, 5);
const conf = conferidoEm(a);
const nivel = nivelVerificacao(a);
const NIVEL: Record<string, string> = { 'fonte-publica': 'Conferido em fonte pública', 'confirmado-com-a-academia': 'Confirmado com a academia', visita: 'Verificado em visita' };
const CAMPOS: Record<string, string> = { endereco: 'endereço', geo: 'localização', horario: 'horário', modalidades: 'modalidades', comodidades: 'estrutura', agregadores: 'planos nos agregadores', mensalidade: 'mensalidade' };
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${d.nome}, ${d.endereco}`)}`;
const abs = (u: string) => new URL(u, Astro.site).href;
const titulo = d.titulo_seo ?? `${d.nome}: horários, endereço e planos`;
const descricao = `${d.resumo} Dados conferidos em ${dataCurta(conf)}.`.slice(0, 160);
const schema = [{
  '@type': 'Article', headline: titulo, description: d.resumo, inLanguage: 'pt-BR',
  datePublished: dataIso(d.publicado_em), dateModified: dataIso(d.atualizado_em),
  author: { '@type': 'Organization', name: 'Guia Fitness Alphaville', url: abs('/sobre/') },
  publisher: { '@id': abs('/#org') }, mainEntityOfPage: { '@id': `${abs(urlAcademia(a))}#pagina` },
  about: { '@type': 'Place', name: d.nome, address: d.endereco },
}];
const eSite = d.site && !/instagram\.com/.test(d.site);
const hojeIso = new Date().toISOString().slice(0, 10);
---
<Base titulo={titulo} descricao={descricao} tipo="article" schema={schema} migalhas={[{ nome: 'Academias', url: '/academias/' }, { nome: d.nome, url: urlAcademia(a) }]}>
  <div class="wrap">
    <header class="cab-pag">
      <span class="rotulo cor-marca">{TIPOS[d.tipo]} · {regiao.nome} · {d.bairro}</span>
      <h1>{d.nome}</h1>
      <p class="linha-fina">{d.resumo}</p>
      <Assinatura autor={d.autor} revisor={d.revisor} publicado={d.publicado_em} atualizado={d.atualizado_em} />
    </header>

    <div class="ficha">
      <div>
        <i data-dado="i" hidden></i>
        <div class="resposta">
          <span class="rotulo">Dados principais</span>
          <p><strong>Endereço:</strong> {d.endereco}. <strong>Horário:</strong> {horarioResumo(d.horario)}. <strong>Mensalidade:</strong> {d.mensalidade ? d.mensalidade.valor : 'não confirmada com a academia'}.</p>
        </div>
        <i data-dado="f" hidden></i>

        <div class="prosa">
          <h2>O que observar em {d.nome.replace(/^Academia /, '')}</h2>
          {d.analise.map((p) => <p>{p}</p>)}

          {d.divergencias.length > 0 && (
            <div class="caixa alerta" style="margin-bottom:18px">
              <h3>As fontes não batem</h3>
              <ul>{d.divergencias.map((x) => <li>{x}</li>)}</ul>
            </div>
          )}

          <i data-dado="i" hidden></i>
          {d.mensalidade && (
            <>
              <h2>Quanto custa</h2>
              <p>{d.mensalidade.resumo} {d.mensalidade.abrangencia === 'rede' ? 'É o preço anunciado pela rede, não necessariamente o da unidade.' : ''}</p>
              <div class="rolagem" tabindex="0" role="region" aria-label={`Planos de ${d.nome}`} style="margin-bottom:12px">
                <table class="dados" style="min-width:0">
                  <caption>Fonte: <a href={d.mensalidade.url} rel="noopener nofollow">{d.mensalidade.fonte}</a>, consultada em {dataLonga(d.mensalidade.conferido_em)}.</caption>
                  <thead><tr><th scope="col">Plano</th><th scope="col">Preço</th><th scope="col">Condições</th></tr></thead>
                  <tbody>{d.mensalidade.planos.map((p) => <tr><th scope="row">{p.nome}</th><td style="white-space:nowrap">{p.preco}</td><td>{p.condicoes}</td></tr>)}</tbody>
                </table>
              </div>
              {d.mensalidade.aviso && <p style="font-size:16px;color:var(--cinza)">{d.mensalidade.aviso}</p>}
              <p style="font-size:16px"><a href="/academias/precos/">Comparar com os preços de outras academias</a></p>
            </>
          )}

          <h2>Modalidades</h2>
          <ul class="tags" style="margin-bottom:14px">{d.modalidades.map((m) => <li>{MODALIDADES[m]}</li>)}</ul>
          {d.atividades_listadas.length > 0 && <p style="font-size:16px;color:var(--cinza)">Atividades listadas pela fonte: {d.atividades_listadas.join(', ')}.</p>}

          {d.comodidades.length > 0 && <>
            <h2>Estrutura informada</h2>
            <ul class="colunas">{d.comodidades.map((c) => <li>{c}</li>)}</ul>
          </>}
          <i data-dado="f" hidden></i>

          <h2>O que ainda não confirmamos</h2>
          <ul>{d.pendencias.map((x) => <li>{x}</li>)}</ul>
          <p><a href="/correcoes/">Enviar uma correção ou um dado que falta</a></p>
        </div>

        <i data-dado="i" hidden></i>
        <div style="margin-top:28px">
          <Fontes fontes={d.proveniencia.map((p) => ({ titulo: `${p.fonte} (${p.campos.map((c) => CAMPOS[c] ?? c).join(', ')})`, url: p.url, data: dataLonga(p.conferido_em) }))} />
        </div>
        <i data-dado="f" hidden></i>
      </div>
      <i data-dado="i" hidden></i>

      <aside aria-label="Dados da academia">
        <div class="caixa">
          <h2>Onde fica</h2>
          <p>{d.endereco}</p>
          <p><a class="link-forte" href={maps} rel="noopener nofollow" data-evento="clique_mapa_externo" data-ref={a.id}>Abrir no Google Maps</a></p>
          {d.telefone && <p style="font-size:16px">Telefone: {d.telefone}</p>}
          {d.site && <p style="font-size:16px"><a href={d.site} rel="noopener nofollow" data-evento="clique_site_academia" data-ref={a.id}>{eSite ? 'Site da academia' : 'Instagram da academia'}</a></p>}
        </div>
        <div class="caixa">
          <h2>Horário de funcionamento</h2>
          {e24hTodos({ horario: d.horario as any, horario_status: d.horario_status as any }) ? <p><strong>24 horas, todos os dias</strong>, segundo a fonte.</p> : (
            <table class="horarios">
              <tbody>{DIAS.map((dia) => <tr><th scope="row">{DIAS_NOME[dia]}</th><td>{d.horario_status?.[dia] === 'a-confirmar' ? <span class="incerto">a confirmar{d.horario[dia].length ? ` (as fontes divergem; uma informa ${faixasDia(d.horario[dia])})` : ''}</span> : d.horario[dia].length ? <>{faixasDia(d.horario[dia])}{d.ultima_entrada?.[dia] && <> · última entrada {d.ultima_entrada[dia]}</>}</> : d.horario_status?.[dia] === 'fechado' ? 'Fechado' : <span class="incerto">sem horário listado</span>}</td></tr>)}</tbody>
            </table>
          )}
          {d.horario_feriados && <p style="font-size:15px"><strong>Feriados (horário padrão publicado):</strong> {faixasDia(d.horario_feriados.faixas)}. É uma regra geral da academia; confirme a data.</p>}
          {d.horario_excecoes.filter((e) => e.data >= hojeIso).map((e) => <p style="font-size:15px"><strong>{e.data.split('-').reverse().join('/')}:</strong> {e.faixas.length ? faixasDia(e.faixas) : 'fechada'} ({e.motivo}{e.situacao === 'a-confirmar' ? ', a confirmar' : ''}).</p>)}
          {d.horario_fonte && <p style="font-size:14px;color:var(--cinza)">Horário conferido em {dataLonga(d.horario_fonte.conferido_em)}: {d.horario_fonte.url ? <a href={d.horario_fonte.url} rel="nofollow noopener">{d.horario_fonte.fonte}</a> : d.horario_fonte.fonte}.</p>}
          {d.modalidades.includes('musculacao') && <p style="font-size:16px"><a class="link-forte" href={`/ferramentas/academias-abertas-alphaville/?agora=1&regiao=${d.regiao}`} data-evento="clique_ferramenta" data-ref="abertas:ficha">Ver academias abertas neste horário</a></p>}

        </div>
        {d.agregadores.length > 0 && (
          <div class="caixa">
            <h2>Agregadores</h2>
            {d.agregadores.map((g) => <p><strong>{g.nome}:</strong> a partir do plano {g.plano_minimo} ({g.preco_plano}/mês, preço de referência do benefício). {g.musculacao === false && d.modalidades.includes('musculacao') ? 'A página do benefício não lista musculação nesta unidade. ' : ''}{g.nota} {(g.condicoes ?? []).join(' ')} <a href={`/academias/wellhub-totalpass/?b=${g.nome.toLowerCase()}&plano=${encodeURIComponent(g.plano_minimo)}`} data-evento="clique_buscador_beneficio" data-ref={`ficha-${a.id}`} style="font-size:15px">Outras unidades no {g.plano_minimo}</a></p>)}
            <p style="font-size:15px"><a href="/academias/wellhub-totalpass/" data-evento="clique_buscador_beneficio" data-ref={`ficha-${a.id}`}>Buscador de Wellhub e TotalPass</a></p>
          </div>
        )}
        <div class="caixa">
          <Selo texto={`${NIVEL[nivel]} em ${dataCurta(conf)}`} />
          {d.montinho_atende && <p style="font-size:15px;margin-top:10px"><strong>Relação comercial:</strong> o Montinho Personal Trainer, que mantém este guia, atende alunos nesta academia.</p>}
          <p style="font-size:15px;margin-top:10px"><a href="/metodologia/">O que este selo significa</a></p>
        </div>
        {d.tipo === 'academia' && (() => { const pe = politicaPE(d.personal_externo); const rr = respostasPE(pe); return (
          <div class="caixa">
            <h2>Personal externo</h2>
            <p><strong>{STATUS_PE[pe.status].rotulo}.</strong> {rr.posso !== 'Sim.' && rr.posso !== 'Sim, com condições.' ? '' : rr.antes.join(' ')}</p>
            <p style="font-size:15px">Taxa: {rr.taxa}</p>
            <p style="font-size:14px;color:var(--cinza)">{pe.conferido ? <>Verificado em {dataCurta(pe.conferido)}{pe.url ? <> · <a href={pe.url} rel="nofollow noopener" target="_blank">fonte</a></> : ''}.</> : 'Sem fonte pública com a regra desta unidade.'}</p>
            <p style="font-size:15px"><a href="/ferramentas/academias-que-aceitam-personal-externo/" data-evento="clique_guia_personal_externo" data-ref={`ficha-${a.id}`}>Academias que aceitam personal externo</a></p>
          </div>); })()}
        <a class="btn sec" href={`/ferramentas/comparador/?a=${a.id}`}>Comparar com outra academia <i aria-hidden="true"></i></a>
        <a class="link-forte" href={`/ferramentas/custo-para-treinar-em-alphaville/?a=${a.id}&de=ficha`}>Calcular custo para treinar nesta unidade</a>
      </aside>
      <i data-dado="f" hidden></i>
    </div>

    <i data-dado="i" hidden></i>
    {d.montinho_atende && (
      <section class="bloco fino"><Mantem pagina={`ficha-${a.id}`} compacta titulo={`Treine na ${d.nome} com acompanhamento`} texto={`O Montinho Personal Trainer, que mantém este guia, atende alunos presencialmente na ${d.nome}. Este bloco é publicidade da casa; a ficha acima segue os mesmos critérios das demais.`} /></section>
    )}
    {FOTO_MONTINHO[a.id] && (FOTO_MONTINHO[a.id].fotos.length === 1
      ? <figure class="bloco fino" style="margin:28px auto 0;max-width:420px"><Image src={FOTO_MONTINHO[a.id].fotos[0].src} alt={FOTO_MONTINHO[a.id].fotos[0].alt} widths={[420, 840]} sizes="(max-width: 460px) 100vw, 420px" style="width:100%;height:auto;border-radius:12px" /><figcaption style="font-size:14px;text-align:center;margin-top:6px">{FOTO_MONTINHO[a.id].legenda}</figcaption></figure>
      : <figure class="bloco fino galeria-montinho" style="margin:28px auto 0;max-width:760px"><div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px">{FOTO_MONTINHO[a.id].fotos.map((f, i) => <Image src={f.src} alt={f.alt} widths={[360, 720]} sizes="(max-width: 780px) 46vw, 370px" style="width:100%;height:auto;aspect-ratio:9/16;object-fit:cover;border-radius:12px" />)}</div><figcaption style="font-size:14px;text-align:center;margin-top:8px">{FOTO_MONTINHO[a.id].legenda}</figcaption></figure>)}
    {d.montinho_atende && <Vitrine pagina={`ficha-${a.id}`} destaque="natalia-nascimento" intro={`O Montinho atende alunos na ${d.nome}, mas a vitrine abaixo não informa onde cada pessoa treinou. São resultados de emagrecimento de alunos dele, publicados no site montinhopersonal.com.br.`} />}
    <Perguntas itens={d.perguntas} titulo={`Perguntas sobre a ${d.nome}`} />
    <section class="bloco fino prosa" aria-labelledby="perto-t">
      <h2 id="perto-t">Outras opções em {regiao.titulo}</h2>
      <ul>{vizinhas.map((o) => <li><a href={urlAcademia(o)}>{o.data.nome}</a> — {o.data.bairro}</li>)}</ul>
      <p><a href={urlRegiao(d.regiao)}>Todas as academias de {regiao.titulo}</a> · <a href="/guias/como-escolher-academia/">Como escolher uma academia</a></p>
    </section>
    <section class="bloco fino prosa" aria-labelledby="guias-t">
      <h2 id="guias-t">Guias relacionados</h2>
      <ul>
        {temPersonal && <li><a href={`/guias/personal-trainer-${a.id}/`}>Personal trainer na {d.nome}</a>: como funciona o treino acompanhado nesta academia.</li>}
        {guiasRel.map((u) => <li><a href={u}>{ARTIGOS[u].titulo}</a>: {ARTIGOS[u].resumo}</li>)}
      </ul>
    </section>
    <i data-dado="f" hidden></i>
  </div>
</Base>
