---
import Base from '../../layouts/Base.astro';
import CartaoAcademia from '../../components/CartaoAcademia.astro';
import Assinatura from '../../components/Assinatura.astro';
import Mantem from '../../components/Mantem.astro';
import Perguntas from '../../components/Perguntas.astro';
import { academias, REGIOES, e24h, abreDomingo, agregador, urlAcademia, urlRegiao, dataIso, faixasDia, type Academia, type RegiaoId } from '../../lib/dados';

export async function getStaticPaths() {
  const todas = await academias();
  return (Object.keys(REGIOES) as RegiaoId[]).map((regiao) => ({ params: { regiao }, props: { xs: todas.filter((a) => a.data.regiao === regiao) } })).filter((p) => p.props.xs.length >= 3);
}
const { regiao } = Astro.params as { regiao: RegiaoId };
const { xs } = Astro.props as { xs: Academia[] };
const r = REGIOES[regiao];
const gov = { autor: 'Redação do Onde Treinar Alphaville', revisor: null, publicado: new Date('2026-11-13'), atualizado: new Date('2026-11-13') };

const bairros = [...new Set(xs.map((a) => a.data.bairro))].map((b) => ({ b, as: xs.filter((a) => a.data.bairro === b) })).sort((x, y) => y.as.length - x.as.length);
const rua = (a: Academia) => a.data.endereco.split(',')[0];
const naVia = (v: string) => xs.filter((a) => rua(a).includes(v));
const n = (f: (a: Academia) => boolean) => xs.filter(f).length;
const km = (a: Academia, b: Academia) => { const R = 6371, rad = (x: number) => (x * Math.PI) / 180, dLa = rad(b.data.geo.lat - a.data.geo.lat), dLo = rad(b.data.geo.lng - a.data.geo.lng); const h = Math.sin(dLa / 2) ** 2 + Math.cos(rad(a.data.geo.lat)) * Math.cos(rad(b.data.geo.lat)) * Math.sin(dLo / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(h)); };
const dists = xs.flatMap((a, i) => xs.slice(i + 1).map((b) => km(a, b)));
const distMin = Math.min(...dists), distMax = Math.max(...dists);
const nomes = (as: Academia[]) => as.map((a) => a.data.nome).join(', ').replace(/, ([^,]*)$/, ' e $1');
const fmt = (x: number) => x.toFixed(1).replace('.', ',');
const jurua = naVia('Juruá'), araguaia = naVia('Araguaia');
const boxes = xs.filter((a) => a.data.tipo === 'box');
const redes = xs.filter((a) => a.data.rede);

const ach = (id: string) => xs.find((a) => a.id === id);
const end = (a?: Academia) => a ? a.data.endereco.split(' - ').slice(0, 2).join(', ') : '';
const perguntasAlpha = (() => {
  if (regiao !== 'alphaville') return [];
  const out: { p: string; r: string }[] = [];
  const h24 = xs.filter((a) => e24h(a.data.horario));
  if (h24.length) out.push({ p: 'Qual academia de Alphaville abre 24 horas?', r: `${h24.map((a) => `${a.data.nome} (${end(a)})`).join(' e ')} ${h24.length > 1 ? 'são as academias' : 'é a academia'} do guia com horário publicado de 24 horas.` });
  const ib = ach('ironberg-alphaville');
  if (ib?.data.mensalidade) out.push({ p: 'Quanto custa a mensalidade da Ironberg Alphaville?', r: `${ib.data.mensalidade.resumo} Os planos publicados pela rede são: ${ib.data.mensalidade.planos.map((x) => `${x.nome}, ${x.preco}`).join('; ')}.` });
  const gv = ach('gavioes-24h-alphaville');
  if (gv) { const w = agregador(gv, 'Wellhub'), t = agregador(gv, 'TotalPass'); out.push({ p: 'Quanto custa a Academia Gaviões Alphaville?', r: `A Gaviões não publica mensalidade nem diária. Pelos agregadores, entra a partir ${[w && `do ${w.plano_minimo} do Wellhub (${w.preco_plano})`, t && `do ${t.plano_minimo} do TotalPass (${t.preco_plano})`].filter(Boolean).join(' e ')}.` }); }
  const six = ach('six-alphaville');
  if (six) out.push({ p: 'Onde fica a SIX academia em Alphaville?', r: `A SIX fica na ${end(six)}, no 23º andar do Empresarial 18 do Forte. Não publica preço no site; valores citados à imprensa a colocam como a academia mais cara da região.` });
  const sc = ach('scelta-alphaville');
  if (sc) out.push({ p: 'Qual o horário da Scelta em Alphaville?', r: `A Scelta, na ${end(sc)}, funciona de segunda a sexta ${faixasDia(sc.data.horario.seg)}, no sábado ${faixasDia(sc.data.horario.sab)} e no domingo ${faixasDia(sc.data.horario.dom)}, segundo as fontes da ficha.` });
  const bf = ach('bluefit-alphaville');
  if (bf) out.push({ p: 'Onde fica a Bluefit em Alphaville?', r: `Há duas unidades com ficha no guia: a Bluefit Alphaville, na ${end(bf)}, e a Bluefit Tamboré, na Av. Tucunaré. A rede não publica a mensalidade das unidades.` });
  const vf = ach('voifit-alphaville');
  if (vf) out.push({ p: 'Onde fica a VoiFit em Alphaville?', r: `A VoiFit fica na ${end(vf)}, no Empresarial 18 do Forte, e funciona de segunda a sexta ${faixasDia(vf.data.horario.seg)}.` });
  const comPreco = xs.filter((a) => a.data.mensalidade && a.data.tipo === 'academia').map((a) => ({ a, v: Math.min(...a.data.mensalidade!.planos.filter((p) => !/aula|teste|drop|pacote|diária|day use|fim de semana/i.test(p.nome)).map((p) => Number(p.preco.replace(/[^\d,]/g, '').replace(',', '.')))) })).sort((x, y) => x.v - y.v);
  if (comPreco.length) out.push({ p: 'Qual a academia mais barata de Alphaville?', r: `Entre as academias de Alphaville que publicam preço, a mensalidade de entrada mais baixa é a da ${comPreco[0].a.data.nome}, a partir de R$ ${comPreco[0].v.toFixed(2).replace('.', ',')} por mês. Outras academias não divulgam valores.` });
  out.push({ p: 'Alphaville fica em Barueri ou em Santana de Parnaíba?', r: 'Nos dois. A parte comercial e boa parte das academias deste guia ficam do lado de Barueri, como o Alphaville Industrial, o Centro Comercial e o 18 do Forte. Muitos residenciais e o trecho da Estrada da Bela Vista ficam em Santana de Parnaíba.' });
  return out;
})();
const perguntasBarueri = (() => {
  if (regiao !== 'barueri') return [];
  const out: { p: string; r: string }[] = [];
  const centro = xs.filter((a) => /centro/i.test(a.data.bairro));
  if (centro.length) out.push({ p: 'Quais academias ficam no centro de Barueri?', r: `${centro.map((a) => `${a.data.nome} (${end(a)})`).join('; ')}. ${centro.filter((a) => a.data.mensalidade).map((a) => `${a.data.nome}: ${a.data.mensalidade!.valor}`).join('; ')}.` });
  const sf = xs.filter((a) => a.data.rede === 'Smart Fit');
  if (sf.length) out.push({ p: 'Onde tem Smart Fit em Barueri?', r: `O guia tem ${sf.length} unidades da Smart Fit na cidade: ${sf.map((a) => `${a.data.nome} (${end(a)})`).join('; ')}. A unidade da Sodimac fica em Alphaville, que também pertence a Barueri.` });
  const pb = ach('panobianco-barueri-centro');
  if (pb) out.push({ p: 'Quanto custa a Panobianco Barueri Centro?', r: `${pb.data.mensalidade ? pb.data.mensalidade.resumo + ' ' : ''}O guia ainda não confirmou se a unidade do centro pratica o preço anunciado pela rede. Ela fica na ${end(pb)} e funciona de segunda a quinta ${faixasDia(pb.data.horario.seg)}.` });
  out.push({ p: 'Tem academia 24 horas em Barueri?', r: 'Fora de Alphaville, nenhuma academia com ficha no guia tem horário de 24 horas. As duas academias 24 horas do guia, Gaviões 24h e Ironberg, ficam em Alphaville, que faz parte do município de Barueri.' });
  const comPreco = xs.filter((a) => a.data.mensalidade).map((a) => ({ a, v: Math.min(...a.data.mensalidade!.planos.filter((p) => !/aula|teste|drop|pacote|diária|day use|fim de semana/i.test(p.nome)).map((p) => Number(p.preco.replace(/[^\d,]/g, '').replace(',', '.')))) })).sort((x, y) => x.v - y.v);
  if (comPreco.length) out.push({ p: 'Qual a academia mais barata de Barueri?', r: `Pelos preços publicados, a mensalidade de entrada mais baixa é a da ${comPreco[0].a.data.nome}, a partir de R$ ${comPreco[0].v.toFixed(2).replace('.', ',')} por mês com fidelidade. Algumas academias de bairro não divulgam valores e podem cobrar menos.` });
  out.push({ p: 'Tem academia perto das estações de trem de Barueri?', r: 'Sim. Pelas coordenadas das fichas, a Smart Fit do Parque Shopping fica a cerca de 300 metros em linha reta da estação Antônio João, o CT Don Combat a cerca de 400 metros da estação Barueri e a Smart Fit Barueri Centro a cerca de 800 metros da estação Jardim Belval. A página Academia perto de você traz a lista completa.' });
  out.push({ p: 'A SkyFit fica em Barueri?', r: 'Sim. A SkyFit com ficha no guia fica na Av. Juruá, 307, no Alphaville Industrial, que pertence a Barueri. Por isso ela aparece na região de Alphaville e Tamboré.' });
  return out;
})();
const META: Record<RegiaoId, { titulo: string; descricao: string; h1: string; fina: string }> = {
  alphaville: { titulo: 'Academia em Alphaville: opções, preços e horários por bairro', descricao: `Academias em Alphaville, Tamboré e 18 do Forte: ${xs.length} opções por bairro, com endereço, horário, preço publicado, Wellhub e TotalPass. Gaviões, Ironberg, SIX e mais.`, h1: 'Academias em Alphaville e Tamboré: onde treinar', fina: 'Alphaville Industrial, Empresarial 18 do Forte, o entorno do Iguatemi e o Tamboré, bairro a bairro.' },
  barueri: { titulo: 'Academia em Barueri: centro, preços e perto das estações', descricao: `Academias em Barueri fora de Alphaville: ${xs.length} opções no centro, em Bethaville, no Parque Shopping e no sul, com horários, preços e distância das estações.`, h1: 'Academias em Barueri: onde treinar', fina: 'Centro, Bethaville, Parque Shopping, sul de Barueri e Vila Engenho Novo, para quem mora ou trabalha fora dos bairros de Alphaville.' },
  'santana-de-parnaiba': { titulo: 'Academias em Santana de Parnaíba: onde treinar', descricao: `Onde treinar em Santana de Parnaíba: ${xs.length} academias na Fazendinha, no Polvilho, no Jardim São Luís e na Estrada da Bela Vista, com horários e endereço.`, h1: 'Onde treinar em Santana de Parnaíba', fina: 'Fazendinha, Polvilho, Jardim São Luís e o lado de Alphaville na Estrada da Bela Vista, em pontos distantes do município.' },
};
const m = META[regiao];
const outras = (Object.keys(REGIOES) as RegiaoId[]).filter((x) => x !== regiao);
const abs = (u: string) => new URL(u, Astro.site).href;
const schema = [
  { '@type': 'Article', headline: m.h1, description: m.descricao, inLanguage: 'pt-BR', datePublished: dataIso(gov.publicado), dateModified: dataIso(gov.atualizado), author: { '@type': 'Organization', name: 'Onde Treinar Alphaville', url: abs('/sobre/') }, publisher: { '@id': abs('/#org') } },
  { '@type': 'ItemList', name: m.h1, numberOfItems: xs.length, itemListElement: xs.map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.data.nome, url: abs(urlAcademia(a)) })) },
];
---
<Base titulo={m.titulo} descricao={m.descricao} tipo="article" schema={schema} migalhas={[{ nome: 'Regiões', url: '/regioes/' }, { nome: r.titulo, url: urlRegiao(regiao) }]}>
  <div class="wrap">
    <header class="cab-pag">
      <span class="rotulo cor-marca">Região</span>
      <h1>{m.h1}</h1>
      <p class="linha-fina">{m.fina}</p>
      <Assinatura {...gov} />
    </header>

    {regiao === 'alphaville' && (
      <>
        <div class="resposta"><span class="rotulo">Em resumo</span>
          <p>Há {xs.length} lugares com ficha em Alphaville e Tamboré. {jurua.length + araguaia.length} deles ficam em apenas duas vias de Alphaville Industrial, a Av. Juruá e a Alameda Araguaia. {n((a) => e24h(a.data.horario)) === 1 ? 'Um funciona 24 horas' : `${n((a) => e24h(a.data.horario))} funcionam 24 horas`}, {n((a) => abreDomingo(a.data.horario))} abrem aos domingos e {boxes.length} são boxes de CrossFit ou cross training.</p>
        </div>
        <div class="prosa">
          <h2>Alphaville Industrial: duas vias concentram a oferta</h2>
          <p>Das {xs.length} fichas da região, {xs.filter((a) => a.data.bairro === 'Alphaville Industrial').length} ficam em Alphaville Industrial. E dentro do bairro a oferta se concentra em dois eixos.</p>
          <p>Na <strong>Av. Juruá</strong> ficam {nomes(jurua)}. Gaviões e Fast Treino dividem o mesmo número, e SkyFit e CrossFit Barueri também. Na prática, são quatro propostas diferentes — musculação 24 horas, circuito rápido, academia de rede e box — em dois números vizinhos da mesma avenida, o que facilita visitar todas no mesmo dia.</p>
          <p>Na <strong>Alameda Araguaia</strong> ficam {nomes(araguaia)}. Os dois boxes de treino em aula, Templo SA e BlackSheep, ocupam galpões do mesmo conjunto, no número 122. A Smart Fit fica mais adiante, no estacionamento da Sodimac.</p>
          <p>Fora desses dois eixos, mas ainda no bairro, estão a <a href="/academias/bluefit-alphaville/">Bluefit Alphaville</a>, na Alameda Amazonas, e a <a href="/academias/24h-premium-alphaville/">Academia 24h Premium</a>, na Alameda Grajaú.</p>

          <h2>Iguatemi, Alphaville Empresarial e 18 do Forte</h2>
          <p>Quatro academias atendem quem circula pelos centros empresariais e comerciais. A <a href="/academias/bodytech-iguatemi-alphaville/">Bodytech</a> fica na Alameda Rio Negro, junto ao Iguatemi Alphaville, e tem a grade de aulas mais extensa do guia, mas não lista horário aos domingos. A <a href="/academias/scelta-alphaville/">Academia Scelta</a>, na Av. Andrômeda, abre todos os dias e informa serviços como fisioterapeuta e cafeteria. No Empresarial 18 do Forte ficam duas opções de perfis opostos: a <a href="/academias/voifit-alphaville/">VoiFit</a>, academia de rede na Av. Alphaville, e a <a href="/academias/six-alphaville/">SIX Alphaville</a>, wellness club no 23º andar com spa, valet e mensalidade de outra ordem de grandeza.</p>

          <h2>Arena 18, no Melville Empresarial</h2>
          <p>Ao norte, na Rua Mario Quintana, a <a href="/academias/arena-18-alphaville/">Arena 18</a> é a única academia do guia que junta musculação, funcional e HIIT com quadras de areia para beach tennis, futevôlei e vôlei. A estrutura informada inclui sauna, banho de gelo, spa, fisioterapeuta e nutricionista. O Montinho Personal Trainer, que mantém este guia, atende alunos lá.</p>

          <h2>Ironberg, na Estrada da Aldeinha</h2>
          <p>A <a href="/academias/ironberg-alphaville/">Ironberg Alphaville</a> fica fora dos bairros residenciais, na Estrada da Aldeinha, com acesso pela rodovia. É a maior academia do guia em área declarada, funciona 24 horas e tem estacionamento gratuito. É também uma das poucas que publicam preço: a partir de R$ 399 por mês no plano de 12 meses. Veja a comparação com a NitroGym do Tamboré em <a href="/guias/ironberg-ou-nitrogym/">Ironberg ou NitroGym</a>.</p>

          <h2>Tamboré</h2>
          <p>Duas academias do Tamboré têm ficha. A <a href="/academias/nitrogym-tambore/">NitroGym</a>, no Shopping Tamboré, é a opção premium do bairro, com estacionamento do shopping incluso por 3 horas e planos a partir de R$ 389 por mês. A <a href="/academias/bluefit-tambore/">Bluefit Tamboré</a>, na Av. Tucunaré, é a opção de rede de baixo custo. Como a regra do guia pede ao menos três academias para uma página de região, o Tamboré segue dentro desta página.</p>

          <h2>Como escolher dentro da região</h2>
          <ul>
            <li><strong>Treina de madrugada ou em turnos?</strong> Veja as <a href="/academias/24-horas/">academias 24 horas</a>.</li>
            <li><strong>Só treina no fim de semana?</strong> Veja as <a href="/academias/domingo/">academias abertas no domingo</a>.</li>
            <li><strong>Procura só musculação?</strong> Quase todas oferecem; veja <a href="/modalidades/musculacao/">o que observar na sala de pesos</a>.</li>
            <li><strong>Quer treino em aula, com coach?</strong> Os boxes estão em <a href="/modalidades/crossfit/">CrossFit e cross training</a>.</li>
            <li><strong>Usa Wellhub ou TotalPass?</strong> O plano mínimo varia de Silver a Gold+ na região. Veja <a href="/academias/wellhub-totalpass/">o que cada plano abre</a>.</li>
            <li><strong>Mora em condomínio com academia?</strong> Vale pesar se a estrutura do residencial já resolve. O guia <a href="/guias/academia-ou-personal/">academia, personal ou os dois</a> trata disso.</li>
          </ul>
        </div>
      </>
    )}

    {regiao === 'barueri' && (
      <>
        <div class="resposta"><span class="rotulo">Em resumo</span>
          <p>Barueri tem {xs.length} academias com ficha, espalhadas por {bairros.length} bairros fora de Alphaville. {n((a) => a.data.rede === 'Smart Fit')} são unidades da Smart Fit, todas com preço publicado a partir de R$ 139,90 por mês (compare as unidades em <a href="/academias/smart-fit-barueri/">Smart Fit em Barueri</a>). {n((a) => abreDomingo(a.data.horario))} abrem aos domingos, e só uma tem piscina: a Boa Forma, no Jardim Alberto.</p>
        </div>
        <div class="prosa">
          <h2>Centro de Barueri</h2>
          <p>Quatro opções ficam no centro ou a poucas quadras dele. A <a href="/academias/smart-fit-barueri-centro/">Smart Fit Barueri Centro</a>, na Av. Vinte e Seis de Março, e a <a href="/academias/panobianco-barueri-centro/">Panobianco Barueri Centro</a>, na Rua José Maria Balieiro, abrem às 5h, fecham perto da meia-noite e funcionam também no fim de semana. A Smart Fit cobra R$ 139,90 no Plano Fit; a Panobianco anuncia R$ 119,90 no plano anual da rede, mas o valor da unidade não foi confirmado.</p>
          <p>Perto da Prefeitura, a <a href="/academias/xandu-barueri/">Academia Xandu</a> é uma academia de bairro com dança, jump e bike, e a única do guia que entra no plano mais barato do Wellhub. Para lutas, o <a href="/academias/ct-don-combat-barueri/">CT Don Combat</a>, no endereço da antiga Killer Bees, oferece boxe e muay thai.</p>
          <h2>Bethaville e Parque Shopping</h2>
          <p>No caminho entre o centro e Alphaville estão a <a href="/academias/bluefit-barueri/">Bluefit Barueri</a>, na Av. Trindade, em Bethaville, que lista muay thai e jiu-jitsu além da musculação, e a <a href="/academias/smart-fit-parque-shopping-barueri/">Smart Fit do Parque Shopping Barueri</a>, aberta até a meia-noite em dias úteis. Ficam a cerca de {fmt(km(xs.find((a) => a.id === 'bluefit-barueri')!, xs.find((a) => a.id === 'smart-fit-parque-shopping-barueri')!))} km uma da outra, em linha reta.</p>
          <h2>Sul de Barueri</h2>
          <p>A <a href="/academias/smart-fit-barueri-av-zelia/">Smart Fit da Av. Zélia</a>, no Parque dos Camargos, é uma das unidades da rede mais procuradas da região. Abre às 5h e fecha às 23h em dias úteis. No Jardim Alberto, a <a href="/academias/boa-forma-barueri/">Academia Boa Forma</a> tem piscina, natação e hidroginástica, e não lista horário aos domingos.</p>
          <h2>Vila Engenho Novo</h2>
          <p>Ao norte, perto do limite com Santana de Parnaíba, a <a href="/academias/impacto-barueri/">Academia Impacto</a> combina musculação, lutas e cross training e abre às 5h em dias úteis.</p>
          <h2>Barueri ou Alphaville?</h2>
          <p>Para quem mora em Barueri e trabalha em Alphaville, as mesmas redes estão nos dois lugares. Na Smart Fit, o Plano Fit, de R$ 139,90, só existe nas unidades de Barueri; na de Alphaville, o plano de entrada é o Smart, a R$ 149,90. Nos agregadores, as academias de Barueri também tendem a pedir planos mais baratos: a Panobianco entra no Wellhub pelo Basic, a Xandu pelo Starter, enquanto as redes de <a href="/regioes/alphaville/">Alphaville</a> pedem Silver ou Silver+. Compare tudo em <a href="/academias/precos/">quanto custa academia</a>.</p>
          <p>Os boxes de CrossFit mais próximos ficam em Alphaville Industrial. Um deles se chama CrossFit Barueri, mas o endereço é na Av. Juruá. Veja em <a href="/modalidades/crossfit/">CrossFit e cross training</a>.</p>
        </div>
      </>
    )}

    {regiao === 'santana-de-parnaiba' && (
      <>
        <div class="resposta"><span class="rotulo">Em resumo</span>
          <p>Santana de Parnaíba tem {xs.length} academias com ficha, cada uma em um bairro: {bairros.map((b) => b.b).join(', ').replace(/, ([^,]*)$/, ' e $1')}. Só a Fábrica Premium, do lado de Alphaville, abre aos domingos. Em linha reta, a distância entre elas vai de {fmt(distMin)} a {fmt(distMax)} km, então a escolha aqui é, antes de tudo, pelo bairro.</p>
        </div>
        <div class="prosa">
          <h2>Uma academia por bairro</h2>
          <p>Diferente de Alphaville, onde várias academias dividem a mesma avenida, as opções de Santana de Parnaíba estão espalhadas pelo município.</p>
          <ul>
            <li><strong>Lado de Alphaville:</strong> a <a href="/academias/fabrica-premium-alphaville/">Fábrica Premium Alphaville</a>, na Estrada da Bela Vista, quase em frente ao Condomínio Burle Marx, é a opção de alto padrão do município, com valet, rooftop com pista de corrida e crioterapia. Não publica preço.</li>
            <li><strong>Fazendinha:</strong> a <a href="/academias/mattos-fitness-fazendinha/">Academia Mattos Fitness</a>, na Estrada Tenente Marques, abre às 4h em dias úteis e tem lutas além da musculação.</li>
            <li><strong>Polvilho:</strong> a <a href="/academias/olympia-fitness-polvilho/">Olympia Fitness</a>, na Rua Tocantins, fecha das 12h às 14h. Quem treina no almoço precisa saber disso antes.</li>
            <li><strong>Jardim São Luís:</strong> a <a href="/academias/forth-academia-jardim-sao-luis/">Forth Academia</a> fica aberta até a meia-noite de segunda a sexta e lista pilates e funcional.</li>
          </ul>
          <h2>Domingo e agregadores</h2>
          <p>A Fábrica Premium abre das 8h às 14h aos domingos e feriados. As academias da Fazendinha, do Polvilho e do Jardim São Luís não têm horário listado para domingo, e no sábado fecham até as 15h. Quem treina no fim de semana encontra mais opções nas redes de <a href="/regioes/barueri/">Barueri</a> e de <a href="/regioes/alphaville/">Alphaville</a>. Veja todas em <a href="/academias/domingo/">academias abertas no domingo</a>.</p>
          <p>As três academias de bairro estão no Wellhub em planos de entrada: Basic para a Mattos e a Olympia, Basic+ para a Forth. É a faixa de entrada mais baixa do guia, a mesma da Panobianco de Barueri. O que cada plano custa está em <a href="/academias/wellhub-totalpass/">Wellhub e TotalPass</a>.</p>
          <h2>O que falta aqui</h2>
          <p>Este recorte é pequeno. Faltam o centro histórico, outros trechos do lado de Alphaville e a Aldeia da Serra. Se você conhece uma academia desses bairros, <a href="/correcoes/">envie os dados</a> para que ela entre no guia.</p>
        </div>
      </>
    )}

    <section class="bloco fino" aria-labelledby="lista-t">
      <div class="cab"><h2 id="lista-t">Academias de {r.titulo}, por bairro</h2><a class="link-forte" href={`/academias/?regiao=${regiao}`}>Abrir no guia com filtros</a></div>
      {bairros.map(({ b, as }) => (
        <>
          <h3 style="font-size:20px;margin:22px 0 12px">{b} <span style="color:var(--cinza);font-weight:500">· {as.length}</span></h3>
          <div class="cartoes">{as.map((a) => <CartaoAcademia a={a} nivel="h4" />)}</div>
        </>
      ))}
    </section>

    <section class="bloco fino prosa">
      <h2>Outras regiões</h2>
      <ul>{outras.map((o) => <li><a href={urlRegiao(o)}>Onde treinar em {REGIOES[o].titulo}</a></li>)}</ul>
    </section>
    <section class="bloco fino prosa">
      <h2>Treinar com personal trainer</h2>
      <ul>
        {regiao === 'alphaville' && <><li><a href="/guias/personal-trainer-alphaville/">Personal trainer em Alphaville</a></li><li><a href="/guias/personal-trainer-tambore/">Personal trainer no Tamboré</a></li></>}
        {regiao === 'barueri' && <li><a href="/guias/personal-trainer-barueri/">Personal trainer em Barueri</a></li>}
        {regiao === 'santana-de-parnaiba' && <><li><a href="/guias/personal-trainer-santana-de-parnaiba/">Personal trainer em Santana de Parnaíba</a></li><li><a href="/guias/personal-trainer-aldeia-da-serra/">Personal trainer na Aldeia da Serra</a></li></>}
      </ul>
    </section>
    <Perguntas itens={perguntasAlpha} titulo="Perguntas frequentes sobre academias em Alphaville" />
    <Perguntas itens={perguntasBarueri} titulo="Perguntas frequentes sobre academias em Barueri" id="perguntas-barueri" />
    {regiao === 'alphaville' && <section class="bloco fino"><Mantem pagina={`regiao-${regiao}`} compacta titulo="Converse com um personal em Alphaville" texto="O Montinho Personal Trainer, que mantém este guia, atende presencialmente em academias e condomínios de Alphaville e Tamboré." /></section>}
  </div>
</Base>
