---
import { comDestaque as __comDestaque, academias as __academias, linkMontinho } from '../../lib/dados';
import fotoMontinho from '../../assets/montinho/montinho-ironberg-espelho.jpg';
import { Image } from 'astro:assets';
import FerramentasContexto from '../../components/FerramentasContexto.astro';
import { ferramentasPara } from '../../lib/ferramentas';
import Base from '../../layouts/Base.astro';
import Assinatura from '../../components/Assinatura.astro';
import Fontes from '../../components/Fontes.astro';
import CartaoAcademia from '../../components/CartaoAcademia.astro';
import VideoMontinho from '../../components/VideoMontinho.astro';
import Perguntas from '../../components/Perguntas.astro';
import LeiaTambem from '../../components/LeiaTambem.astro';
import { academias, MODALIDADES, agregador, urlAcademia, dataLonga, dataIso } from '../../lib/dados';

const gov = { autor: 'Redação do Guia Fitness Alphaville', revisor: null, publicado: new Date('2026-11-23'), atualizado: new Date('2026-11-23') };
const todas = await academias();
const ib = todas.find((a) => a.id === 'ironberg-alphaville')!;
const bt = todas.find((a) => a.id === 'bodytech-iguatemi-alphaville')!;
const km = (() => { const R = 6371, rad = (x: number) => (x * Math.PI) / 180, a = ib.data.geo, b = bt.data.geo; const dLa = rad(b.lat - a.lat), dLo = rad(b.lng - a.lng); const h = Math.sin(dLa / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLo / 2) ** 2; return (2 * R * Math.asin(Math.sqrt(h))).toFixed(1).replace('.', ','); })();
const wBt = agregador(bt, 'Wellhub'), tIb = agregador(ib, 'TotalPass');
const mods = (xs: string[]) => xs.map((m) => MODALIDADES[m as keyof typeof MODALIDADES]).join(', ');
const linhas: [string, string, string][] = [
  ['Onde fica', 'Estrada da Aldeinha, 181, Jardim Santa Cecília', 'Alameda Rio Negro, 111, junto ao Shopping Iguatemi Alphaville'],
  ['Horário', '24 horas, todos os dias, inclusive feriados (site da rede)', 'Das 6h às 22h de segunda a sexta e das 9h às 15h no sábado; a fonte não traz horário de domingo'],
  ['Mensalidade', 'A partir de R$ 399/mês no plano de 12 meses + matrícula de R$ 120', 'Não publicada'],
  ['Diária', 'Day Pass de R$ 120 no site da unidade', 'Não publicada'],
  ['Wellhub', 'Não consta', wBt ? `a partir do ${wBt.plano_minimo} (${wBt.preco_plano}), só em horários específicos` : 'Não consta'],
  ['TotalPass', tIb ? `a partir do ${tIb.plano_minimo} (${tIb.preco_plano})` : 'Não consta', 'Não encontrada'],
  ['Modalidades', mods(ib.data.modalidades), mods(bt.data.modalidades)],
  ['Aulas coletivas', 'Não tem grade de aulas; o Day Pass cita Hyrox e Ironbike onde houver', `Mais de 30 atividades listadas no Wellhub (${bt.data.atividades_listadas.length})`],
  ['Estrutura destacada', '32 mil m² declarados; lounge; acessibilidade; heliponto', 'Armários, toalhas de treino, nutricionista e Wi-Fi'],
  ['Estacionamento', 'Gratuito, mais de 1.000 vagas', 'Consta na ficha, sem regra de preço publicada'],
  ['Personal de fora', 'Aceito, com valor fixo pago pelo profissional (R$ 1.000 por mês, segundo o Montinho)', 'Regra não publicada'],
];
const perguntas = [
  { p: 'Qual é melhor, Ironberg ou Bodytech?', r: 'Depende do treino. A Ironberg é só musculação, em 32 mil m² declarados, aberta 24 horas e com preço publicado. A Bodytech Iguatemi tem mais de 30 atividades, como corrida, bike, boxe, muay thai, dança e pilates, mas fecha às 22h, abre só até as 15h no sábado e não publica mensalidade. Para musculação e horário livre, a Ironberg; para aulas variadas perto do Iguatemi, a Bodytech.' },
  { p: 'Quanto custa a diária da Ironberg Alphaville?', r: 'O Day Pass custa R$ 120 no site da unidade, vale até 23h59 do dia de uso e pode ser usado em até 7 dias depois da compra. A Bodytech não publica diária nas fontes conferidas pelo guia.' },
  { p: 'Quanto custa a mensalidade da Bodytech Alphaville?', r: 'A Bodytech não publica a mensalidade da unidade Iguatemi Alphaville nas fontes consultadas pelo guia. Peça o valor na recepção. Para comparar, a Ironberg publica R$ 399 por mês no plano de 12 meses, mais R$ 120 de matrícula.' },
  { p: 'A Ironberg ou a Bodytech aceitam Wellhub e TotalPass?', r: `Cada uma aceita um. A Bodytech Iguatemi entra no Wellhub a partir do ${wBt?.plano_minimo} (${wBt?.preco_plano}), mas, segundo o Wellhub, nesse plano o acesso vale só em horários específicos. A Ironberg entra no TotalPass a partir do ${tIb?.plano_minimo} (${tIb?.preco_plano}) e não aparece no Wellhub.` },
  { p: 'A Ironberg vale a pena?', r: 'Vale para quem treina musculação com frequência, quer espaço e aparelho sem fila e precisa de horário livre, inclusive de madrugada e no feriado. Para quem quer aulas coletivas, não: a unidade não tem grade de aulas. O Day Pass de R$ 120 é um jeito de testar antes de assinar.' },
  { p: 'A Bodytech Alphaville abre domingo?', r: 'A fonte da ficha, a página da unidade no Wellhub, não traz horário de domingo, e no sábado a unidade funciona das 9h às 15h. Confirme antes de ir. A Ironberg publica 24 horas todos os dias.' },
];
const abs = (u: string) => new URL(u, Astro.site).href;
const titulo = 'Ironberg ou Bodytech em Alphaville: qual academia escolher';
const descricao = 'Ironberg ou Bodytech em Alphaville: musculação 24 horas com preço publicado ou mais de 30 aulas no Iguatemi. Preço, horário, Wellhub e TotalPass.';
const schema = [{ '@type': 'Article', headline: titulo, description: descricao, inLanguage: 'pt-BR', datePublished: dataIso(gov.publicado), dateModified: dataIso(gov.atualizado), author: { '@type': 'Organization', name: 'Guia Fitness Alphaville', url: abs('/sobre/') }, publisher: { '@id': abs('/#org') } }];
const ferramentas = ferramentasPara({ tipo: 'comparativo', academias: [{ id: 'ironberg-alphaville', nome: 'Ironberg' }, { id: 'bodytech-iguatemi-alphaville', nome: 'Bodytech Iguatemi' }] });
const __todasDestaque = await __academias();
---
<Base titulo={titulo} descricao={descricao} tipo="article" schema={schema} migalhas={[{ nome: 'Guias', url: '/guias/' }, { nome: 'Ironberg ou Bodytech', url: '/guias/ironberg-ou-bodytech/' }]}>
  <div class="wrap">
    <header class="cab-pag">
      <span class="rotulo cor-marca">Guias de decisão · comparativo</span>
      <h1>Ironberg ou Bodytech em Alphaville: qual academia escolher</h1>
      <p class="linha-fina">Duas academias de preço alto, a cerca de {km} km uma da outra em linha reta, com propostas opostas: uma é só musculação, em escala; a outra vive de aulas.</p>
      <Assinatura {...gov} />
    </header>

    <div class="resposta">
      <span class="rotulo">Resposta direta</span>
      <p>Escolha a Ironberg se o seu treino é musculação, se você quer saber o preço antes de ir e se precisa de horário livre: ela abre 24 horas todos os dias e tem Day Pass de R$ 120. Escolha a Bodytech Iguatemi se você quer alternar musculação com aulas (corrida, bike, boxe, muay thai, dança, pilates) e treina em horário comercial: ela fecha às 22h, funciona só até as 15h no sábado e não publica mensalidade. Com Wellhub, só a Bodytech entra; com TotalPass, só a Ironberg.</p>
    </div>
    <FerramentasContexto itens={ferramentas} modo="atalho" />

    <div class="rolagem" tabindex="0" role="region" aria-label="Ironberg e Bodytech lado a lado" style="margin:24px 0">
      <table class="dados">
        <caption>Dados das fichas do guia. Abra cada ficha para ver as fontes e as datas de conferência.</caption>
        <thead><tr><th scope="col">Critério</th><th scope="col"><a href={urlAcademia(ib)} style="color:inherit">{ib.data.nome}</a></th><th scope="col"><a href={urlAcademia(bt)} style="color:inherit">{bt.data.nome}</a></th></tr></thead>
        <tbody>{linhas.map(([c, a, b]) => <tr><th scope="row">{c}</th><td>{a}</td><td>{b}</td></tr>)}</tbody>
      </table>
    </div>

    <div class="prosa">
      <h2>Salão de musculação contra grade de aulas</h2>
      <p>A Ironberg não tem grade de aulas coletivas. O que ela oferece é espaço: o site da rede fala em 32 mil m² e se apresenta como o maior centro de treinamento de musculação do mundo, afirmação da própria rede. Na prática, a promessa é encontrar o aparelho livre e várias opções para o mesmo músculo. A Bodytech Iguatemi vai pelo outro caminho: a página da unidade no Wellhub lista {bt.data.atividades_listadas.length} atividades, de musculação e aula de corrida a indoor bike, boxe, muay thai, zumba, balé e mat pilates. É a grade mais extensa entre as academias deste guia.</p>
      <p>Se você faz só musculação, a variedade da Bodytech não pesa. Se gosta de trocar de atividade ao longo da semana, a Ironberg não supre isso, e você teria de combinar com outro lugar.</p>

      <h2>Horário: a maior diferença do dia a dia</h2>
      <p>A Ironberg funciona 24 horas, inclusive em feriados, segundo o site da rede. A Bodytech abre das 6h às 22h nos dias úteis e das 9h às 15h no sábado, e a fonte da ficha não traz horário de domingo. Para quem treina cedo antes do trabalho no Iguatemi ou no Centro Empresarial, as duas servem. Para quem só consegue treinar à noite, depois das 22h, ou no domingo, a conta pende para a Ironberg. Veja todas as opções por horário em <a href="/ferramentas/academias-abertas-alphaville/">academias abertas agora</a>.</p>

      <h2>Preço: um lado publicado, outro não</h2>
      <p>A Ironberg publica a tabela da rede: R$ 399 por mês no plano de 12 meses, R$ 499 no de 6 meses e R$ 599 no recorrente, sempre com matrícula de R$ 120. Também vende o Day Pass a R$ 120 no site da unidade. A Bodytech não publica mensalidade nem diária da unidade Iguatemi Alphaville nas fontes conferidas pelo guia. Para comparar de verdade, peça o valor na recepção. Outras formas de testar sem matrícula estão em <a href="/ferramentas/academias-diaria-aula-experimental-alphaville/" data-evento="clique_ferramenta" data-ref="diaria:ironberg-ou-bodytech">diária e aula experimental</a>.</p>
      <p>Com agregador, as duas não se cruzam: a Bodytech entra no Wellhub a partir do {wBt?.plano_minimo}, com acesso só em horários específicos nesse plano, e a Ironberg entra no TotalPass a partir do {tIb?.plano_minimo}. Os planos estão em <a href="/academias/wellhub-totalpass/">Wellhub e TotalPass</a>.</p>

      <h2>Chegar e estacionar</h2>
      <p>A Bodytech fica na Alameda Rio Negro, junto ao Shopping Iguatemi Alphaville, no miolo comercial do bairro: dá para encaixar o treino entre trabalho e compras. A Ironberg fica na Estrada da Aldeinha, fora dos bairros residenciais, com estacionamento gratuito para mais de mil carros. Quem mora na Aldeia da Serra ou em Santana de Parnaíba tende a passar mais perto da Ironberg. A <a href="/ferramentas/academia-perto-de-casa-ou-do-trabalho/" data-evento="clique_ferramenta" data-ref="caminho:ironberg-ou-bodytech">ferramenta de academia perto de casa ou do trabalho</a> mostra qual fica no seu caminho.</p>

      <h2>Quem treina com personal</h2>
      <p>A Ironberg aceita personal de fora: o site da rede informa que o profissional paga um valor fixo à academia. Na unidade de Alphaville, segundo o Montinho, que mantém este guia, esse valor é de R$ 1.000 por mês. A Bodytech não publica regra para personal externo nas perguntas frequentes do site. Pergunte na recepção antes de combinar aulas. Os guias <a href="/guias/personal-trainer-ironberg-alphaville/">personal trainer na Ironberg</a> e <a href="/guias/personal-trainer-bodytech-iguatemi-alphaville/">personal trainer na Bodytech</a> listam o que perguntar.</p>

      <h2>Resumo por perfil</h2>
      <ul>
        <li><strong>Faz só musculação:</strong> Ironberg.</li>
        <li><strong>Quer aulas de corrida, bike, luta, dança ou pilates:</strong> Bodytech.</li>
        <li><strong>Treina depois das 22h, no domingo ou no feriado:</strong> Ironberg.</li>
        <li><strong>Quer saber o preço antes de ir:</strong> Ironberg.</li>
        <li><strong>Tem Wellhub:</strong> Bodytech, conferindo os horários do plano. <strong>Tem TotalPass:</strong> Ironberg.</li>
        <li><strong>Trabalha perto do Iguatemi:</strong> Bodytech.</li>
      </ul>
      <p>Compare também com <a href="/guias/gavioes-ou-ironberg/">Gaviões ou Ironberg</a>, <a href="/guias/ironberg-ou-smart-fit/">Ironberg ou Smart Fit</a>, <a href="/guias/ironberg-ou-nitrogym/">Ironberg ou NitroGym</a> e o panorama de <a href="/guias/academias-premium-alphaville/">academias premium em Alphaville</a>. O <a href={`/ferramentas/comparador/?a=${ib.id}&b=${bt.id}`} data-evento="clique_ferramenta" data-ref="comparador:ironberg-ou-bodytech">comparador</a> mostra as duas fichas completas lado a lado. O site do Montinho tem ainda um texto sobre a <a href={linkMontinho('/blog/bodytech-alphaville', 'texto', 'ironberg-ou-bodytech')} rel="nofollow" data-evento="clique_montinho" data-ref="ironberg-ou-bodytech">Bodytech Alphaville</a>.</p>
    </div>

    <section class="bloco fino" aria-labelledby="fichas-t">
      <div class="cab"><h2 id="fichas-t">As duas fichas</h2><a class="link-forte" href="/academias/precos/">Preços das academias</a></div>
      <div class="cartoes">{__comDestaque([ib, bt], __todasDestaque).map((a) => <CartaoAcademia a={a} />)}</div>
    </section>

    <figure class="bloco fino" style="margin:28px auto 0;max-width:420px"><Image src={fotoMontinho} alt="Montinho em frente ao espelho na sala de musculação da Ironberg" widths={[420, 840]} sizes="(max-width: 460px) 100vw, 420px" style="width:100%;height:auto;border-radius:12px" /><figcaption style="font-size:14px;text-align:center;margin-top:6px">O Montinho na Ironberg. Foto dele, tirada na academia. Publicidade da casa.</figcaption></figure>
    <FerramentasContexto itens={ferramentas} />

    <VideoMontinho id="Mck7dwGz0as" titulo="O aparelho está ocupado? O que fazer no lugar" pagina="ironberg-ou-bodytech" />
    <Perguntas itens={perguntas} titulo="Perguntas sobre Ironberg e Bodytech" />
    <LeiaTambem url="/guias/ironberg-ou-bodytech/" />
    <div style="margin-top:28px"><Fontes fontes={[
      ...ib.data.proveniencia.map((p) => ({ titulo: `${p.fonte} — ${ib.data.nome}`, url: p.url, data: dataLonga(p.conferido_em) })),
      ...bt.data.proveniencia.map((p) => ({ titulo: `${p.fonte} — ${bt.data.nome}`, url: p.url, data: dataLonga(p.conferido_em) })),
    ]} /></div>
  </div>
</Base>
