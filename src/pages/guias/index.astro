---
import Base from '../../layouts/Base.astro';
import { guias } from '../../lib/dados';
const todos = (await guias()).filter((g) => g.data.secao === 'guias');
const gs = todos.filter((g) => !g.id.startsWith('personal-trainer-'));
const ORDEM = ['alphaville', 'tambore', 'barueri', 'santana-de-parnaiba', 'aldeia-da-serra'];
const personal = todos.filter((g) => g.id.startsWith('personal-trainer-')).sort((a, b) => ORDEM.indexOf(a.id.slice(17)) - ORDEM.indexOf(b.id.slice(17)));
const itens = [
  ...gs.map((g) => ({ url: `/guias/${g.id}/`, t: g.data.h1, p: g.data.descricao })),
  { url: '/guias/smart-fit-ou-gavioes/', t: 'Smart Fit ou Gaviões em Alphaville: qual escolher', p: 'Horário, preço, modalidades e agregadores das duas academias lado a lado.' },
  { url: '/guias/ironberg-ou-nitrogym/', t: 'Ironberg ou NitroGym em Alphaville: qual escolher', p: 'Custo do primeiro ano, horário, estacionamento, TotalPass e regra para personal nas duas academias de musculação premium.' },
  { url: '/academias/precos/', t: 'Quanto custa academia em Alphaville e Barueri', p: 'As mensalidades publicadas pelas academias, com fonte e data, e o plano de agregador que cada uma exige.' },
  { url: '/academias/24-horas/', t: 'Academias 24 horas em Alphaville e região', p: 'Quais têm horário publicado de 24 horas, quais só parecem ter, e as que abrem mais cedo e fecham mais tarde.' },
  { url: '/academias/wellhub-totalpass/', t: 'Academias com Wellhub e TotalPass', p: 'O plano mínimo que cada academia exige em cada agregador, e quanto esse plano custa.' },
];
---
<Base titulo="Guias para escolher onde e como treinar" descricao="Guias de decisão do Onde Treinar Alphaville: como escolher academia, academia ou personal, horários estendidos e agregadores como Wellhub e TotalPass." migalhas={[{ nome: 'Guias', url: '/guias/' }]}>
  <div class="wrap">
    <header class="cab-pag">
      <span class="rotulo cor-marca">Guias de decisão</span>
      <h1>Antes de assinar o plano</h1>
      <p class="linha-fina">Textos curtos para decidir onde e como treinar, apoiados nos dados das fichas.</p>
    </header>
    <ol class="guias">{itens.map((g) => <li><a href={g.url}><h2 style="font-size:23px;font-weight:700">{g.t}</h2><p>{g.p}</p></a></li>)}</ol>
    <section class="bloco fino prosa" aria-labelledby="pt-t">
      <h2 id="pt-t">Personal trainer por região</h2>
      <p>Onde o treino acompanhado pode acontecer em cada parte da região: academia, condomínio ou casa.</p>
      <ul class="lista-links">{personal.map((g) => <li><a href={`/guias/${g.id}/`}>{g.data.h1}</a></li>)}</ul>
    </section>
    <div class="prosa" style="margin-top:28px"><p>Um guia previsto ainda não foi publicado porque depende de levantamento direto: as regras de cada condomínio para treinar com personal. Ele entra quando os dados existirem.</p></div>
  </div>
</Base>
