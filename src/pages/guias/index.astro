---
import Base from '../../layouts/Base.astro';
import { guias, academias, REGIOES } from '../../lib/dados';
import { CIDADES_PT, TEMAS_PT, temaCidade, urlTema } from '../../lib/artigos';
const todos = (await guias()).filter((g) => g.data.secao === 'guias');
const gs = todos.filter((g) => !g.id.startsWith('personal-trainer-') && !/hyrox/.test(g.id));
const hyrox = todos.filter((g) => /hyrox/.test(g.id));
const ORDEM = ['alphaville', 'tambore', 'barueri', 'santana-de-parnaiba', 'aldeia-da-serra'];
const personal = todos.filter((g) => ORDEM.includes(g.id.slice(17))).sort((a, b) => ORDEM.indexOf(a.id.slice(17)) - ORDEM.indexOf(b.id.slice(17)));
const publicados = new Set(todos.map((g) => temaCidade(g.id)).filter(Boolean).map((x) => `${x!.tema}|${x!.cidade}`));
const todasAc = await academias();
const porAcademia = (Object.keys(REGIOES) as (keyof typeof REGIOES)[]).map((r) => ({ r, xs: todasAc.filter((a) => a.data.regiao === r && todos.some((g) => g.id === `personal-trainer-${a.id}`)).sort((x, y) => x.data.nome.localeCompare(y.data.nome)) })).filter((x) => x.xs.length);
const temas = Object.keys(TEMAS_PT).filter((t) => ORDEM.some((c) => publicados.has(`${t}|${c}`)));
const itens = [
  ...gs.map((g) => ({ url: `/guias/${g.id}/`, t: g.data.h1, p: g.data.descricao })),
  { url: '/guias/smart-fit-ou-gavioes/', t: 'Smart Fit ou Gaviões em Alphaville: qual escolher', p: 'Horário, preço, modalidades e agregadores das duas academias lado a lado.' },
  { url: '/guias/ironberg-ou-nitrogym/', t: 'Ironberg ou NitroGym em Alphaville: qual escolher', p: 'Custo do primeiro ano, horário, estacionamento, TotalPass e regra para personal nas duas academias de musculação premium.' },
  { url: '/guias/gavioes-ou-ironberg/', t: 'Gaviões 24h ou Ironberg: qual academia 24 horas escolher', p: 'As duas únicas 24 horas do guia comparadas em preço, aulas, estrutura e regra para personal.' },
  { url: '/academias/smart-fit-barueri/', t: 'Smart Fit em Barueri: as 4 unidades', p: 'Centro, Parque Shopping, Av. Zélia e Sodimac Alphaville com horário, endereço, plano de entrada e TotalPass.' },
  { url: '/academias/perto-de/', t: 'Academia perto do Iguatemi, Shopping Tamboré e estações', p: 'As academias mais próximas dos pontos de referência da região, com distância em linha reta.' },
  { url: '/academias/precos/', t: 'Quanto custa academia em Alphaville e Barueri', p: 'As mensalidades publicadas pelas academias, com fonte e data, e o plano de agregador que cada uma exige.' },
  { url: '/academias/24-horas/', t: 'Academias 24 horas em Alphaville e região', p: 'Quais têm horário publicado de 24 horas, quais só parecem ter, e as que abrem mais cedo e fecham mais tarde.' },
  { url: '/academias/domingo/', t: 'Academias abertas no domingo', p: 'Quem abre no domingo, até que horas, e onde dá para treinar depois do almoço.' },
  { url: '/academias/wellhub-totalpass/', t: 'Academias com Wellhub e TotalPass', p: 'O plano mínimo que cada academia exige em cada agregador, e quanto esse plano custa.' },
];
---
<Base titulo="Guias para escolher onde e como treinar" descricao="Guias de decisão do Onde Treinar Alphaville: como escolher academia, academia ou personal, horários estendidos e agregadores como Wellhub e TotalPass." migalhas={[{ nome: 'Guias', url: '/guias/' }]}>
  <div class="wrap">
    <header class="cab-pag">
      <span class="rotulo cor-marca">Guias de decisão</span>
      <h1>Antes de assinar o plano</h1>
      <p class="linha-fina">Textos curtos para decidir onde e como treinar, apoiados nos dados das fichas.</p>
    </header>
    <ol class="guias">{itens.map((g) => <li><a href={g.url}><h2 style="font-size:23px;font-weight:700">{g.t}</h2><p>{g.p}</p></a></li>)}</ol>
    <section class="bloco fino prosa" aria-labelledby="pt-t">
      <h2 id="pt-t">Personal trainer por região</h2>
      <p>Onde o treino acompanhado pode acontecer em cada parte da região: academia, condomínio ou casa.</p>
      <ul class="lista-links">{personal.map((g) => <li><a href={`/guias/${g.id}/`}>{g.data.h1}</a></li>)}</ul>
      {temas.length > 0 && (
        <>
          <h3>Personal trainer por tema e cidade</h3>
          <div class="rolagem" tabindex="0" role="region" aria-label="Guias de personal por tema e cidade">
            <table class="dados">
              <thead><tr><th scope="col">Tema</th>{ORDEM.map((c) => <th scope="col">{CIDADES_PT[c].nome}</th>)}</tr></thead>
              <tbody>{temas.map((t) => <tr><th scope="row">{TEMAS_PT[t].nome}</th>{ORDEM.map((c) => <td>{publicados.has(`${t}|${c}`) ? <a href={urlTema(t, c)}>{CIDADES_PT[c].nome}</a> : '—'}</td>)}</tr>)}</tbody>
            </table>
          </div>
        </>
      )}
      {hyrox.length > 0 && (
        <>
          <h3>Hyrox</h3>
          <ul>
            <li><a href="/modalidades/hyrox/">Hyrox: o que é e como funciona a prova</a></li>
            {hyrox.map((g) => <li><a href={`/guias/${g.id}/`}>{g.data.h1}</a></li>)}
          </ul>
        </>
      )}
      {porAcademia.length > 0 && (
        <>
          <h3>Personal trainer por academia</h3>
          {porAcademia.map(({ r, xs }) => <p><strong>{REGIOES[r].titulo}:</strong> {xs.map((a, i) => <>{i > 0 && ' · '}<a href={`/guias/personal-trainer-${a.id}/`}>{a.data.nome}</a></>)}</p>)}
        </>
      )}
    </section>
    <div class="prosa" style="margin-top:28px"><p>Um guia previsto ainda não foi publicado porque depende de levantamento direto: as regras de cada condomínio para treinar com personal. Ele entra quando os dados existirem.</p></div>
  </div>
</Base>
