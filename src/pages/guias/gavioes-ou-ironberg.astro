---
import { comDestaque as __comDestaque, academias as __academias } from '../../lib/dados';
import fotoMontinho from '../../assets/montinho/montinho-ironberg-abdominal-paralelas.jpg';
import { Image } from 'astro:assets';
import FerramentasContexto from '../../components/FerramentasContexto.astro';
import { ferramentasPara } from '../../lib/ferramentas';
import Base from '../../layouts/Base.astro';
import Assinatura from '../../components/Assinatura.astro';
import Fontes from '../../components/Fontes.astro';
import CartaoAcademia from '../../components/CartaoAcademia.astro';
import VideoMontinho from '../../components/VideoMontinho.astro';
import Perguntas from '../../components/Perguntas.astro';
import LeiaTambem from '../../components/LeiaTambem.astro';
import { academias, MODALIDADES, agregador, urlAcademia, dataLonga, dataIso } from '../../lib/dados';

const gov = { autor: 'Redação do Guia Fitness Alphaville', revisor: null, publicado: new Date('2026-11-15'), atualizado: new Date('2026-11-20') };
const todas = await academias();
const gv = todas.find((a) => a.id === 'gavioes-24h-alphaville')!;
const ib = todas.find((a) => a.id === 'ironberg-alphaville')!;
const km = (() => { const R = 6371, rad = (x: number) => (x * Math.PI) / 180, a = gv.data.geo, b = ib.data.geo; const dLa = rad(b.lat - a.lat), dLo = rad(b.lng - a.lng); const h = Math.sin(dLa / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLo / 2) ** 2; return (2 * R * Math.asin(Math.sqrt(h))).toFixed(1).replace('.', ','); })();
const wGv = agregador(gv, 'Wellhub'), tGv = agregador(gv, 'TotalPass'), tIb = agregador(ib, 'TotalPass');
const mods = (xs: string[]) => xs.map((m) => MODALIDADES[m as keyof typeof MODALIDADES]).join(', ');
const linhas: [string, string, string][] = [
  ['Onde fica', 'Av. Juruá, 253, Alphaville Industrial', 'Estrada da Aldeinha, 181, Jardim Santa Cecília'],
  ['Horário', '24 horas de segunda a sábado; domingo diverge entre as fontes', '24 horas, todos os dias, inclusive feriados (site da rede)'],
  ['Mensalidade', 'Não publicada', 'A partir de R$ 399/mês no plano de 12 meses + matrícula de R$ 120'],
  ['Diária', 'Não publicada', 'Day Pass de R$ 120 no site da unidade'],
  ['Wellhub', wGv ? `a partir do ${wGv.plano_minimo} (${wGv.preco_plano})` : 'Não consta', 'Não consta'],
  ['TotalPass', tGv ? `a partir do ${tGv.plano_minimo} (${tGv.preco_plano})` : 'Não consta', tIb ? `a partir do ${tIb.plano_minimo} (${tIb.preco_plano})` : 'Não consta'],
  ['Modalidades', mods(gv.data.modalidades), mods(ib.data.modalidades)],
  ['Estrutura destacada', 'Rooftop com máquinas; acessibilidade (banheiro, vaga e portas adaptadas)', '32 mil m² declarados; lounge; acessibilidade; heliponto'],
  ['Estacionamento', 'Grátis, com manobrista, segundo o TotalPass', 'Gratuito, mais de 1.000 vagas'],
  ['Personal de fora', 'Regra não publicada', 'Aceito, com valor fixo pago pelo profissional (R$ 1.000 por mês, segundo o Montinho)'],
];
const perguntas = [
  { p: 'Qual é melhor, Gaviões ou Ironberg?', r: 'As duas funcionam 24 horas. A Gaviões 24h Alphaville tem grade de aulas variada (lutas, dança, bike, pilates, yoga) e entra no Wellhub e no TotalPass. A Ironberg é só musculação, em 32 mil m², com preço publicado e estacionamento grátis para mais de mil carros. Para aulas e agregador, a Gaviões; para musculação e preço conhecido, a Ironberg.' },
  { p: 'A Gaviões Alphaville aceita Gympass (Wellhub) e TotalPass?', r: `Aceita os dois. Pela ficha do guia, a Gaviões 24h Alphaville entra no Wellhub, o antigo Gympass, a partir do ${wGv?.plano_minimo} (${wGv?.preco_plano}) e no TotalPass a partir do ${tGv?.plano_minimo} (${tGv?.preco_plano}). A Ironberg aparece só no TotalPass, a partir do ${tIb?.plano_minimo} (${tIb?.preco_plano}).` },
  { p: 'Quanto custa a mensalidade da Gaviões em Alphaville?', r: 'A Gaviões não publica a mensalidade da unidade de Alphaville; o site leva a uma plataforma de matrícula. Peça o valor na recepção. Para comparar, a Ironberg publica R$ 399 por mês no plano de 12 meses, mais matrícula de R$ 120.' },
  { p: 'A Gaviões Alphaville tem diária ou aula experimental?', r: 'As fontes conferidas pelo guia não publicam diária nem aula experimental da Gaviões Alphaville. Pergunte na recepção. A Ironberg vende o Day Pass a R$ 120 no site da unidade.' },
  { p: 'Qual o horário da Gaviões Alphaville?', r: 'A Gaviões 24h Alphaville funciona 24 horas de segunda a sábado. No domingo e nos feriados, as fontes divergem: o Wellhub mostra 24 horas e o TotalPass diz que ela não abre. Confirme antes de ir. A Ironberg publica 24 horas todos os dias.' },
  { p: 'Posso levar meu personal na Gaviões ou na Ironberg?', r: 'Na Ironberg, sim: o site da rede informa que o personal de fora paga um valor fixo à academia, e o Montinho, que mantém este guia, informa que esse valor é de R$ 1.000 por mês na unidade de Alphaville. Na Gaviões Alphaville, a regra não é publicada; pergunte na recepção.' },
];
const abs = (u: string) => new URL(u, Astro.site).href;
const titulo = 'Gaviões 24h ou Ironberg: qual academia 24 horas escolher';
const descricao = 'Gaviões 24h Alphaville ou Ironberg Alphaville: as duas academias 24 horas do guia comparadas em preço, aulas, estrutura, estacionamento e regra para personal.';
const schema = [{ '@type': 'Article', headline: titulo, description: descricao, inLanguage: 'pt-BR', datePublished: dataIso(gov.publicado), dateModified: dataIso(gov.atualizado), author: { '@type': 'Organization', name: 'Guia Fitness Alphaville', url: abs('/sobre/') }, publisher: { '@id': abs('/#org') } }];
const ferramentas = ferramentasPara({ tipo: 'comparativo', academias: [{ id: 'gavioes-24h-alphaville', nome: 'Gaviões 24h' }, { id: 'ironberg-alphaville', nome: 'Ironberg' }] });
const __todasDestaque = await __academias();
---
<Base titulo={titulo} descricao={descricao} tipo="article" schema={schema} migalhas={[{ nome: 'Guias', url: '/guias/' }, { nome: 'Gaviões ou Ironberg', url: '/guias/gavioes-ou-ironberg/' }]}>
  <div class="wrap">
    <header class="cab-pag">
      <span class="rotulo cor-marca">Guias de decisão · comparativo</span>
      <h1>Gaviões 24h ou Ironberg: qual academia 24 horas escolher em Alphaville</h1>
      <p class="linha-fina">São as duas únicas academias do guia com horário publicado de 24 horas, e ficam a cerca de {km} km uma da outra em linha reta. O horário empata; o resto, não.</p>
      <Assinatura {...gov} />
    </header>

    <div class="resposta">
      <span class="rotulo">Resposta direta</span>
      <p>Se você quer variedade de aulas (lutas, dança, bike, pilates, yoga) e usa Wellhub ou um plano de entrada do TotalPass, a Gaviões 24h tende a servir melhor. Se o foco é só musculação, com muito espaço e preço conhecido antes de ir, a Ironberg é a escolha mais previsível. Para quem treina com personal de fora, a Ironberg é a única das duas que publica a regra.</p>
    </div>
    <FerramentasContexto itens={ferramentas} modo="atalho" />

    <div class="rolagem" tabindex="0" role="region" aria-label="Gaviões 24h e Ironberg lado a lado" style="margin:24px 0">
      <table class="dados">
        <caption>Dados das fichas do guia. Abra cada ficha para ver as fontes e as datas de conferência.</caption>
        <thead><tr><th scope="col">Critério</th><th scope="col"><a href={urlAcademia(gv)} style="color:inherit">{gv.data.nome}</a></th><th scope="col"><a href={urlAcademia(ib)} style="color:inherit">{ib.data.nome}</a></th></tr></thead>
        <tbody>{linhas.map(([c, a, b]) => <tr><th scope="row">{c}</th><td>{a}</td><td>{b}</td></tr>)}</tbody>
      </table>
    </div>

    <div class="prosa">
      <h2>O que as duas têm em comum: a madrugada</h2>
      <p>Quem trabalha em turno, volta tarde de viagem ou só consegue treinar antes das 5h tem, no guia, só estas duas opções. No domingo, as fontes da Gaviões divergem: o Wellhub mostra 24 horas e o TotalPass diz que ela não abre. Nenhuma das fontes diz como é o atendimento de madrugada; em academias 24 horas é comum a equipe ser menor nesse período. Se você vai treinar nesse horário, pergunte quem fica na sala e como funciona a entrada. Mais detalhes em <a href="/ferramentas/academias-abertas-alphaville/">academias 24 horas</a>.</p>

      <h2>Preço: um lado publicado, outro não</h2>
      <p>A Ironberg publica a tabela da rede: R$ 399 por mês no plano de 12 meses, R$ 499 no de 6 meses e R$ 599 no recorrente, sempre com matrícula de R$ 120. A Gaviões não publica mensalidade nem diária; a página da unidade leva a uma plataforma de matrícula. Para comparar de verdade, peça o valor na recepção da Gaviões. Para testar antes de assinar, a Ironberg vende o Day Pass a R$ 120 no site da unidade, válido até 23h59 do dia de uso; veja outras opções em <a href="/ferramentas/academias-diaria-aula-experimental-alphaville/" data-evento="clique_ferramenta" data-ref="diaria:gavioes-ou-ironberg">diária e aula experimental</a>.</p>
      <p>Com agregador, a lógica muda: a Gaviões aparece no Wellhub a partir do {wGv?.plano_minimo} e no TotalPass a partir do {tGv?.plano_minimo}; a Ironberg só aparece no TotalPass, a partir do {tIb?.plano_minimo}. Para quem tem TotalPass, a Gaviões exige um plano mais barato. Veja os planos em <a href="/academias/wellhub-totalpass/">Wellhub e TotalPass</a>.</p>

      <h2>Aulas contra espaço</h2>
      <p>A Gaviões tem a grade mais variada das duas: além da musculação, lista funcional, lutas, dança, bike e pilates, e o site da rede menciona um rooftop com máquinas. A Ironberg é só musculação, mas em escala: o site da rede fala em 32 mil m². Quem gosta de alternar aulas na semana tende a preferir a primeira; quem quer salão grande e equipamento sem fila, a segunda.</p>

      <h2>Chegar e estacionar</h2>
      <p>A Gaviões fica na Av. Juruá, no Alphaville Industrial, no mesmo número do Fast Treino e perto da SkyFit. A Ironberg fica na Estrada da Aldeinha, fora dos bairros residenciais, com estacionamento gratuito para mais de mil carros. Na Gaviões, a página do TotalPass lista estacionamento grátis e manobrista; confirme se vale para todos os planos.</p>

      <h2>Quem treina com personal</h2>
      <p>A Ironberg aceita personal de fora: o site da rede informa que o profissional paga um valor fixo à academia, não por aula nem por aluno. Na unidade de Alphaville, segundo o Montinho, que mantém este guia e atende na região, esse valor é de R$ 1.000 por mês. Esse custo costuma estar embutido no preço que o personal cobra. A Gaviões não publica regra. Os guias <a href="/guias/personal-trainer-ironberg-alphaville/">personal trainer na Ironberg</a> e <a href="/guias/personal-trainer-gavioes-24h-alphaville/">personal trainer na Gaviões</a> listam o que perguntar.</p>

      <h2>Resumo por perfil</h2>
      <ul>
        <li><strong>Quer aulas variadas além da musculação:</strong> Gaviões 24h.</li>
        <li><strong>Quer saber o preço antes de ir:</strong> Ironberg.</li>
        <li><strong>Tem Wellhub:</strong> Gaviões. <strong>Tem TotalPass:</strong> as duas, com plano mais barato na Gaviões.</li>
        <li><strong>Precisa treinar de madrugada no domingo:</strong> Ironberg, que publica 24 horas todos os dias.</li>
        <li><strong>Treina com personal de fora:</strong> Ironberg, que publica a regra.</li>
        <li><strong>Trabalha no Alphaville Industrial:</strong> Gaviões, na Av. Juruá.</li>
      </ul>
      <p>Compare também com <a href="/guias/ironberg-ou-nitrogym/">Ironberg ou NitroGym</a>, <a href="/guias/ironberg-ou-smart-fit/">Ironberg ou Smart Fit</a>, <a href="/guias/smart-fit-ou-gavioes/">Smart Fit ou Gaviões</a> e <a href="/guias/panobianco-bluefit-ou-gavioes/">Panobianco, Bluefit ou Gaviões</a>. O <a href={`/ferramentas/comparador/?a=${gv.id}&b=${ib.id}`}>comparador</a> mostra as duas fichas completas lado a lado.</p>
    </div>

    <section class="bloco fino" aria-labelledby="fichas-t">
      <div class="cab"><h2 id="fichas-t">As duas fichas</h2><a class="link-forte" href="/ferramentas/academias-abertas-alphaville/">Academias 24 horas</a></div>
      <div class="cartoes">{__comDestaque([gv, ib], __todasDestaque).map((a) => <CartaoAcademia a={a} />)}</div>
    </section>

    <figure class="bloco fino" style="margin:28px auto 0;max-width:420px"><Image src={fotoMontinho} alt="Montinho fazendo elevação de pernas no aparelho de paralelas da Ironberg" widths={[420, 840]} sizes="(max-width: 460px) 100vw, 420px" style="width:100%;height:auto;border-radius:12px" /><figcaption style="font-size:14px;text-align:center;margin-top:6px">O Montinho treinando na Ironberg. Foto dele, tirada na academia. Publicidade da casa.</figcaption></figure>
    <FerramentasContexto itens={ferramentas} />

    <VideoMontinho id="izMrrSoJGBw" titulo="Raiva e sangue no olho" pagina="gavioes-ou-ironberg" />
    <Perguntas itens={perguntas} titulo="Perguntas sobre Gaviões e Ironberg" />
    <LeiaTambem url="/guias/gavioes-ou-ironberg/" />
    <div style="margin-top:28px"><Fontes fontes={[
      ...gv.data.proveniencia.map((p) => ({ titulo: `${p.fonte} — ${gv.data.nome}`, url: p.url, data: dataLonga(p.conferido_em) })),
      ...ib.data.proveniencia.map((p) => ({ titulo: `${p.fonte} — ${ib.data.nome}`, url: p.url, data: dataLonga(p.conferido_em) })),
    ]} /></div>
  </div>
</Base>
