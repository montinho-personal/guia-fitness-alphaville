---
import { dataLonga } from '../lib/dados';
interface Props { autor: string; revisor: string | null; publicado: Date; atualizado: Date }
const { autor, revisor, publicado, atualizado } = Astro.props;
---
<p class="meta">
  <span>Por {autor}</span>
  <span>Publicado em <time datetime={publicado.toISOString().slice(0, 10)}>{dataLonga(publicado)}</time></span>
  <span>Atualizado em <time datetime={atualizado.toISOString().slice(0, 10)}>{dataLonga(atualizado)}</time></span>
  {revisor && <span>Revisado por {revisor}</span>}
</p>
