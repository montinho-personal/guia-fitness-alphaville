---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Assinatura from './Assinatura.astro';
import Fontes from './Fontes.astro';
import Mantem from './Mantem.astro';
import CartaoAcademia from './CartaoAcademia.astro';
import VideoMontinho from './VideoMontinho.astro';
import LeiaTambem from './LeiaTambem.astro';
import Vitrine from './Vitrine.astro';
import Perguntas from './Perguntas.astro';
import FerramentasContexto from './FerramentasContexto.astro';
import { ferramentasPara, type Contexto, type RegiaoId } from '../lib/ferramentas';
import { CIDADES_PT, TEMAS_PT, urlTema, COMPARATIVOS, personalDaRegiao } from '../lib/artigos';
import { REGIOES, MODALIDADES } from '../lib/dados';
import { academias, guias, dataIso, dataLonga, destaquePrimeiro, eDestaque, type Guia } from '../lib/dados';
interface Props { g: Guia }
const { g } = Astro.props;
const d = g.data;
const { Content } = await render(g);
const SECAO = { modalidades: { nome: 'Modalidades', url: '/modalidades/' }, guias: { nome: 'Guias', url: '/guias/' }, academias: { nome: 'Academias', url: '/academias/' } }[d.secao];
const url = `${SECAO.url}${g.id}/`;
const todas = await academias();
const idsGuias = new Set((await guias()).map((x) => x.id));
const acad = d.academia ? todas.find((x) => x.id === d.academia) : undefined;
if (d.academia && !acad) throw new Error(`academia: ficha ${d.academia} não existe`);
const vizinhasPersonal = acad ? todas.filter((x) => x.id !== acad.id && x.data.regiao === acad.data.regiao && idsGuias.has(`personal-trainer-${x.id}`)).sort((x, y) => Number(y.data.bairro === acad.data.bairro) - Number(x.data.bairro === acad.data.bairro)).slice(0, 8) : [];
const leiaAcad = acad ? [personalDaRegiao(acad.data.regiao, acad.data.bairro), COMPARATIVOS[acad.id], '/guias/academia-ou-personal/', '/academias/precos/'].filter((u): u is string => !!u) : undefined;
const cidadeMae = Object.keys(CIDADES_PT).find((c) => g.id === `personal-trainer-${c}`);
const temasCidade = cidadeMae ? Object.keys(TEMAS_PT).filter((t) => idsGuias.has(`personal-trainer-${t}-${cidadeMae}`)) : [];
const lista = d.lista_ids.length ? d.lista_ids.map((id) => { const a = todas.find((x) => x.id === id); if (!a) throw new Error(`lista_ids: ficha ${id} não existe`); return a; }) : todas.filter((a) => (d.lista_modalidades.length && d.lista_modalidades.some((m) => a.data.modalidades.includes(m))) || (d.lista_tipos.length && d.lista_tipos.includes(a.data.tipo)));
// Ferramentas do contexto: tipo da página, lugar, região e modalidade saem do slug e do frontmatter.
const REG_DA_CIDADE: Record<string, RegiaoId | undefined> = { alphaville: 'alphaville', tambore: 'alphaville', barueri: 'barueri', 'santana-de-parnaiba': 'santana-de-parnaiba', 'aldeia-da-serra': undefined };
const cidadeDoSlug = Object.keys(CIDADES_PT).sort((x, y) => y.length - x.length).find((c) => g.id.endsWith(`-${c}`) || g.id === c);
const ctxBase = { lugar: cidadeDoSlug ? CIDADES_PT[cidadeDoSlug].nome : undefined, regiao: cidadeDoSlug ? REG_DA_CIDADE[cidadeDoSlug] : undefined };
const temaDoSlug = Object.keys(TEMAS_PT).find((t) => g.id.startsWith(`personal-trainer-${t}-`));
const modDaPagina = d.lista_modalidades[0];
const ctx: Contexto | null =
  acad ? { tipo: 'personal-academia', academia: { id: acad.id, nome: acad.data.nome }, regiao: acad.data.regiao as RegiaoId }
  : temaDoSlug === 'a-domicilio' ? { tipo: 'domicilio', ...ctxBase }
  : temaDoSlug === 'em-condominio' ? { tipo: 'condominio', ...ctxBase }
  : temaDoSlug ? { tipo: 'personal-publico', publico: temaDoSlug.replace(/^para-/, ''), ...ctxBase }
  : cidadeMae ? { tipo: 'personal-cidade', ...ctxBase }
  : g.id.includes('hyrox') ? { tipo: 'hyrox', ...ctxBase }
  : g.id === 'como-escolher-academia' ? { tipo: 'como-escolher' }
  : g.id === 'academia-ou-personal' ? { tipo: 'academia-ou-personal' }
  : g.id === 'academias-premium-alphaville' ? { tipo: 'premium' }
  : modDaPagina ? { tipo: 'modalidade', modalidade: modDaPagina, modalidadeNome: MODALIDADES[modDaPagina] ?? modDaPagina, ...ctxBase }
  : /jiu-jitsu|lutas/.test(g.id) ? { tipo: 'modalidade', modalidade: 'lutas', modalidadeNome: 'Lutas', ...ctxBase }
  : null;
const ferramentas = ctx ? ferramentasPara(ctx) : [];
const abs = (u: string) => new URL(u, Astro.site).href;
const video = d.video?.publicado_em ? [{ '@type': 'VideoObject', name: d.video.titulo, description: `${d.video.titulo} — vídeo do Montinho Personal Trainer.`, uploadDate: dataIso(d.video.publicado_em!), thumbnailUrl: `https://i.ytimg.com/vi/${d.video.id}/hqdefault.jpg`, embedUrl: `https://www.youtube-nocookie.com/embed/${d.video.id}`, contentUrl: `https://www.youtube.com/shorts/${d.video.id}` }] : [];
const schema = [...video, { '@type': 'Article', headline: d.h1, description: d.descricao, inLanguage: 'pt-BR', datePublished: dataIso(d.publicado_em), dateModified: dataIso(d.atualizado_em), author: { '@type': 'Organization', name: 'Guia Fitness Alphaville', url: abs('/sobre/') }, publisher: { '@id': abs('/#org') }, mainEntityOfPage: { '@id': `${abs(url)}#pagina` } }];
---
<Base titulo={d.titulo} descricao={d.descricao} tipo="article" schema={schema} migalhas={[SECAO, { nome: d.h1.split(':')[0], url }]}>
  <div class="wrap">
    <header class="cab-pag">
      <span class="rotulo cor-marca">{SECAO.nome}</span>
      <h1>{d.h1}</h1>
      <Assinatura autor={d.autor} revisor={d.revisor} publicado={d.publicado_em} atualizado={d.atualizado_em} />
    </header>
    <div class="resposta"><span class="rotulo">Resposta direta</span><p>{d.resposta}</p></div>
    <FerramentasContexto itens={ferramentas} modo="atalho" />
    <article class="prosa"><Content /></article>
    <FerramentasContexto itens={ferramentas} />

    {lista.length > 0 && (
      <section class="bloco fino" aria-labelledby="lista-t">
        <div class="cab"><h2 id="lista-t">{d.lista_titulo ?? `${lista.length} ${lista.length === 1 ? 'opção' : 'opções'} com ficha no guia`}</h2><a class="link-forte" href="/academias/">Abrir o guia com filtros</a></div>
        <div class="cartoes">{(lista.some(eDestaque) ? destaquePrimeiro(lista, (x) => x) : [...todas.filter(eDestaque), ...lista]).map((a) => <CartaoAcademia a={a} />)}</div>
      </section>
    )}

    <Perguntas itens={d.perguntas} />
    {d.vitrine && <Vitrine intro={d.vitrine.intro} destaque={d.vitrine.destaque} pagina={`guia-${g.id}`} />}
    {d.video && <VideoMontinho id={d.video.id} titulo={d.video.titulo} pagina={`guia-${g.id}`} />}
    {d.cta === 'montinho-contextual' && (
      <section class="bloco fino"><Mantem pagina={`guia-${g.id}`} compacta destino={d.cta_destino} titulo={d.cta_titulo ?? 'Como funciona o acompanhamento presencial do Montinho'} texto={d.cta_texto ?? 'Se você concluiu que quer treinar com acompanhamento, o Montinho Personal Trainer atende em academias e condomínios de Alphaville, Tamboré, Barueri e Santana de Parnaíba. A primeira conversa serve para entender sua rotina e seu objetivo.'} /></section>
    )}
    {cidadeMae && temasCidade.length > 0 && (
      <section class="bloco fino prosa" aria-labelledby="temas-t">
        <h2 id="temas-t">Mais sobre personal {CIDADES_PT[cidadeMae].em}</h2>
        <ul>{temasCidade.map((t) => <li><a href={urlTema(t, cidadeMae)}>{TEMAS_PT[t].nome} {CIDADES_PT[cidadeMae].em}</a>: {TEMAS_PT[t].resumo}</li>)}</ul>
      </section>
    )}
    {acad && vizinhasPersonal.length > 0 && (
      <section class="bloco fino prosa" aria-labelledby="viz-t">
        <h2 id="viz-t">Personal trainer em outras academias de {REGIOES[acad.data.regiao].titulo}</h2>
        <ul>{vizinhasPersonal.map((x) => <li><a href={`/guias/personal-trainer-${x.id}/`}>Personal trainer na {x.data.nome}</a> — {x.data.bairro}</li>)}</ul>
      </section>
    )}
    <LeiaTambem url={url} itens={leiaAcad} />
    <div style="margin-top:28px"><Fontes fontes={[...d.fontes.map((f) => ({ titulo: f.titulo, url: f.url, data: dataLonga(d.atualizado_em) })), ...(d.lista_ids.length ? lista.flatMap((a) => a.data.proveniencia.filter((p) => p.campos.includes('horario')).map((p) => ({ titulo: `${p.fonte} — ${a.data.nome}`, url: p.url, data: dataLonga(p.conferido_em) }))) : [])]} /></div>
  </div>
</Base>
