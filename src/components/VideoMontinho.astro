---
// Vídeo do Montinho (YouTube Shorts), incorporado direto na página.
// Usa o domínio youtube-nocookie e carregamento preguiçoso (só carrega perto da tela).
interface Props { id: string; titulo: string; pagina: string }
const { id, titulo, pagina } = Astro.props;
---
<aside class="video-montinho" aria-label="Vídeo do Montinho" data-ref={pagina}>
  <span class="rotulo cor-marca">Vídeo do Montinho · publicidade da casa</span>
  <h2>{titulo}</h2>
  <div class="video-caixa">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}?rel=0&playsinline=1&modestbranding=1`}
      title={titulo}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  </div>
  <p class="video-link"><a href={`https://www.youtube.com/shorts/${id}`} rel="nofollow noopener" target="_blank" data-evento="video_montinho" data-ref={pagina}>Ver no YouTube</a></p>
</aside>
<style>
  .video-montinho { margin-top: 28px; padding: 22px; border: 1px solid var(--linha, #d8dee8); border-radius: 14px; }
  .video-montinho h2 { font-size: 21px; margin: 6px 0 14px; }
  .video-caixa { position: relative; width: 100%; max-width: 340px; aspect-ratio: 9 / 16; border-radius: 12px; overflow: hidden; background: #000; }
  .video-caixa iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .video-link { margin-top: 10px; font-size: 15px; }
</style>
