---
// Barra fixa no rodapé com chamada para o WhatsApp do Montinho (publicidade da casa).
// Sem JavaScript não aparece. Surge depois de alguma rolagem, some ao ser fechada
// (fica fechada por 3 dias) e nunca cobre o aviso de cookies.
import { academias } from '../lib/dados';
import { ctaDaPagina, linkWhatsappCta } from '../lib/cta';
interface Props { pagina: string }
const { pagina } = Astro.props;
const nomes = Object.fromEntries((await academias()).map((a) => [a.id, a.data.nome]));
const cta = ctaDaPagina(Astro.url.pathname, nomes);
---
<aside class="barra-wa" id="barra-wa" aria-labelledby="barra-wa-t" hidden>
  <div class="barra-wa-in">
    <div class="barra-wa-topo">
      <p><strong id="barra-wa-t">{cta.titulo}</strong><span>{cta.sub}</span></p>
      <button type="button" class="barra-wa-fechar" aria-label="Fechar a chamada para o WhatsApp">×</button>
    </div>
    <a class="barra-wa-btn" href={linkWhatsappCta(cta, `barra-${pagina}`)} target="_blank" rel="nofollow noopener" data-evento="clique_whatsapp" data-ref={`barra-${pagina}`}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
      {cta.botao}
    </a>
  </div>
</aside>
<style>
  .barra-wa { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: var(--tinta); color: #fff; box-shadow: 0 -6px 20px rgba(16, 27, 45, .25); padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); transform: translateY(0); transition: transform .25s ease; }
  .barra-wa[hidden] { display: none; }
  .barra-wa-in { max-width: var(--max); margin: 0 auto; display: grid; gap: 10px; }
  .barra-wa-topo { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .barra-wa-topo p { margin: 0; display: grid; }
  .barra-wa-topo strong { font: 700 17px/1.3 var(--display); }
  .barra-wa-topo span { font-size: 13px; opacity: .75; }
  .barra-wa-fechar { flex: none; width: 36px; height: 36px; border: 0; border-radius: 50%; background: transparent; color: #fff; font-size: 26px; line-height: 1; cursor: pointer; }
  .barra-wa-fechar:hover, .barra-wa-fechar:focus-visible { background: rgba(255, 255, 255, .12); }
  .barra-wa-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 18px; border-radius: 10px; background: #25D366; color: #0B2A17; font: 700 17px/1.2 var(--display); text-decoration: none; }
  .barra-wa-btn:hover { background: #1fbd5a; }
  @media (min-width: 760px) {
    .barra-wa-in { grid-template-columns: 1fr auto; align-items: center; }
    .barra-wa-topo { justify-content: flex-start; }
    .barra-wa-fechar { order: 2; }
    .barra-wa-btn { min-width: 240px; }
  }
  @media (prefers-reduced-motion: reduce) { .barra-wa { transition: none; } }
</style>
<script>
  const barra = document.getElementById('barra-wa');
  const CHAVE = 'ota-barra-wa-fechada';
  const fechadaRecente = () => { try { return Date.now() - Number(localStorage.getItem(CHAVE) || 0) < 3 * 864e5; } catch { return false; } };
  if (barra && !fechadaRecente()) {
    const consent = document.getElementById('consent');
    const ajustar = () => { document.body.style.paddingBottom = barra.hidden ? '' : `${barra.offsetHeight}px`; };
    const mostrar = () => {
      if (consent && !consent.hidden) return; // não cobre o aviso de cookies
      if (window.scrollY < 400) return;       // só depois de alguma rolagem
      barra.hidden = false; ajustar();
      window.removeEventListener('scroll', mostrar);
    };
    window.addEventListener('scroll', mostrar, { passive: true });
    window.addEventListener('resize', ajustar);
    barra.querySelector('.barra-wa-fechar')?.addEventListener('click', () => {
      barra.hidden = true; ajustar();
      try { localStorage.setItem(CHAVE, String(Date.now())); } catch {}
      const w = window as any; if (typeof w.otaEvento === 'function') w.otaEvento('barra_whatsapp_fechada', {});
    });
  }
</script>
