---
// Vídeo do app do Montinho (YouTube Shorts), com a capa original do YouTube.
// Player no modo de privacidade aprimorada e carregamento tardio (só perto da tela).
import { linkMontinho } from '../lib/dados';
interface Props { pagina: string }
const { pagina } = Astro.props;
const ID = 'DPAQDPVffCg';
const titulo = 'Como funciona o acompanhamento no app do Montinho';
---
<figure class="video-app">
  <div class="va-quadro">
    <iframe src={`https://www.youtube-nocookie.com/embed/${ID}?rel=0`} title={titulo} loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
  </div>
  <figcaption>
    A carga da última sessão já preenchida, os recados do Montinho durante a série e a opção de treino para o dia corrido: é pelo app que ele acompanha o aluno da consultoria online entre um check-in e outro. Telas reais, com dados de demonstração.
    <a href={linkMontinho('/videos/app-do-montinho', 'video', pagina)} rel="nofollow" data-evento="clique_montinho" data-ref={pagina}>Ler o resumo do vídeo</a>
  </figcaption>
</figure>

<style>
  .video-app{margin:12px 0 28px;max-width:300px}
  .va-quadro{position:relative;aspect-ratio:9/16;border-radius:12px;overflow:hidden;background:#111827}
  .va-quadro iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .video-app figcaption{font-size:15px;color:var(--cinza);margin-top:10px;line-height:1.5}
  .video-app figcaption a{display:inline-block;margin-top:4px;font-family:var(--display);font-weight:700;color:var(--tinta)}
</style>
