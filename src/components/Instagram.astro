---
// Link para o Instagram do Montinho. variante "linha": link curto com ícone; "cartao": bloco com chamada.
import { INSTAGRAM } from '../lib/dados';
interface Props { pagina: string; variante?: 'linha' | 'cartao'; texto?: string }
const { pagina, variante = 'linha', texto } = Astro.props;
---
{variante === 'linha' ? (
  <a class="ig-linha" href={INSTAGRAM.url} target="_blank" rel="noopener" data-evento="clique_instagram" data-ref={pagina}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/></svg>
    <span>{texto ?? `${INSTAGRAM.usuario} no Instagram`}</span>
  </a>
) : (
  <div class="ig-cartao">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="34" height="34"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/></svg>
    <div>
      <strong>{INSTAGRAM.usuario}</strong>
      <span>{texto ?? 'Dicas de treino, bastidores e transformações de alunos do Montinho.'}</span>
    </div>
    <a class="btn peq sec" href={INSTAGRAM.url} target="_blank" rel="noopener" data-evento="clique_instagram" data-ref={pagina}>Seguir no Instagram</a>
  </div>
)}
<style>
  .ig-linha { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; }
  .ig-linha svg { flex: none; }
  .ig-cartao { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; align-items: center; margin-top: 14px; padding: 14px 16px; border: 1px solid var(--linha); border-radius: 12px; background: var(--cartao); }
  .ig-cartao svg { color: var(--sinal); grid-row: span 2; }
  .ig-cartao strong { display: block; font-family: var(--display); }
  .ig-cartao span { font-size: 15px; color: var(--texto2); }
  .ig-cartao .btn { grid-column: 1 / -1; justify-self: start; }
  @media (min-width: 640px) { .ig-cartao { grid-template-columns: auto 1fr auto; } .ig-cartao svg { grid-row: auto; } .ig-cartao .btn { grid-column: auto; } }
</style>
