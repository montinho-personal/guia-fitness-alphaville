---
// Bloco "Ferramentas para o seu caso": 2 ou 3 ferramentas escolhidas pelo contexto da página,
// já abertas com a academia, a região ou a modalidade do artigo. A primeira também pode aparecer
// como atalho logo abaixo da resposta direta (modo="atalho").
import type { Ferramenta } from '../lib/ferramentas';
interface Props { itens: Ferramenta[]; modo?: 'bloco' | 'atalho'; titulo?: string; }
const { itens, modo = 'bloco', titulo = 'Ferramentas para o seu caso' } = Astro.props;
const principal = itens[0];
---
{modo === 'atalho' && principal && (
  <p class="ferr-atalho nao-imprime"><span class="rotulo">Atalho</span> <a href={principal.href} data-evento="clique_ferramenta" data-ref={`${principal.id}:atalho`}>{principal.titulo}</a></p>
)}
{modo === 'bloco' && itens.length > 0 && (
  <section class="bloco fino ferr nao-imprime" aria-labelledby="ferr-t">
    <div class="cab"><h2 id="ferr-t">{titulo}</h2><a class="link-forte" href="/ferramentas/">Todas as ferramentas</a></div>
    <ul class="ferr-lista">
      {itens.map((x) => (
        <li><a class="ferr-cartao" href={x.href} data-evento="clique_ferramenta" data-ref={`${x.id}:bloco`}>
          <span class="rotulo">{x.rotulo}</span>
          <strong>{x.titulo}</strong>
          <span class="ferr-texto">{x.texto}</span>
          <span class="ferr-ir" aria-hidden="true">Abrir →</span>
        </a></li>
      ))}
    </ul>
  </section>
)}
<style>
  .ferr-atalho { margin: 14px 0 6px; font-size: 15px; display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .ferr-atalho .rotulo { color: #C24E00; }
  .ferr-atalho a { font-weight: 600; }
  .ferr-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .ferr-cartao { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 16px 18px; border: 1px solid var(--linha, #d8dee8); border-left: 4px solid #FF6A00; border-radius: 12px; background: #fff; color: inherit; text-decoration: none; transition: box-shadow .15s, transform .15s; }
  .ferr-cartao:hover, .ferr-cartao:focus-visible { box-shadow: 0 6px 18px rgba(17, 24, 39, .10); transform: translateY(-1px); }
  .ferr-cartao strong { font-size: 17px; line-height: 1.3; }
  .ferr-texto { font-size: 15px; color: var(--cinza, #4b5563); line-height: 1.45; }
  .ferr-ir { margin-top: auto; padding-top: 4px; font-weight: 700; color: #C24E00; font-size: 14px; }
</style>
