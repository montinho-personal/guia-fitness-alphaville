---
// Logo do Guia Fitness Alphaville. "cabecalho" usa o logo horizontal; "rodape", a versão empilhada.
// Versões para fundo escuro: /logo-dark.svg e /logo-footer-dark.svg.
interface Props { variante?: 'cabecalho' | 'rodape' }
const { variante = 'cabecalho' } = Astro.props;
const cab = variante === 'cabecalho';
---
{cab
  ? <img class="logo logo-cab" src="/logo.svg" alt="Guia Fitness Alphaville" width="565" height="122" fetchpriority="high">
  : <img class="logo logo-rod" src="/logo-footer.svg" alt="Guia Fitness Alphaville" width="301" height="150" loading="lazy">}
