---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import Instagram from '../components/Instagram.astro';
import BarraWhatsapp from '../components/BarraWhatsapp.astro';
import Busca from '../components/Busca.astro';
import Marca from '../components/Marca.astro';
import { INDEXAVEL, MOSTRAR_EM_REVISAO, GTM_ID, linkMontinho } from '../lib/dados';

interface Props {
  titulo: string;
  descricao: string;
  migalhas?: { nome: string; url: string }[];
  schema?: Record<string, unknown>[];
  tipo?: 'website' | 'article';
  noindex?: boolean;
  semSufixo?: boolean;
}
const { titulo, descricao, migalhas = [], schema = [], tipo = 'website', noindex = false, semSufixo = false } = Astro.props;
const SITE = 'Guia Fitness Alphaville';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const SUFIXO = ' | Guia Fitness';
// O sufixo da marca só entra quando o título continua com até 60 caracteres.
const tituloCompleto = semSufixo || titulo.length + SUFIXO.length > 60 ? titulo : `${titulo}${SUFIXO}`;
const trilha = [{ nome: 'Início', url: '/' }, ...migalhas];
const abs = (u: string) => new URL(u, Astro.site).href;
const grafo: Record<string, unknown>[] = [
  { '@type': 'WebPage', '@id': `${canonical}#pagina`, url: canonical, name: titulo, description: descricao, inLanguage: 'pt-BR', isPartOf: { '@id': abs('/#site') } },
  ...(migalhas.length ? [{ '@type': 'BreadcrumbList', itemListElement: trilha.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.nome, item: abs(m.url) })) }] : []),
  ...schema,
];
const nav = [
  { nome: 'Academias', url: '/academias/' },
  { nome: 'Regiões', url: '/regioes/' },
  { nome: 'Modalidades', url: '/modalidades/' },
  { nome: 'Guias', url: '/guias/' },
  { nome: 'Ferramentas', url: '/ferramentas/' },
];
// Serviços do Montinho: publicidade da casa, links nofollow com origem marcada.
const servicos = [
  { nome: 'Personal presencial', url: '/consultoria#modalidades' },
  { nome: 'Consultoria online', url: '/consultoria-online' },
  { nome: 'Modelo híbrido', url: '/consultoria#modalidades' },
  { nome: 'Pacote flexível', url: '/consultoria#modalidades' },
  { nome: 'Revisão de execução grátis', url: '/revisao-de-execucao' },
];
// Ferramentas no rodapé: as que respondem a decisões de hoje (onde treinar agora, quanto custa o personal).
const ferrRodape = [
  { ref: 'diaria', nome: 'Diária e aula experimental', url: '/ferramentas/academias-diaria-aula-experimental-alphaville/' },
  { ref: 'abertas', nome: 'Academias abertas agora', url: '/ferramentas/academias-abertas-alphaville/' },
  { ref: 'preco', nome: 'Preço de personal', url: '/ferramentas/calculadora-preco-personal-alphaville/' },
  { ref: 'formato', nome: 'Personal presencial ou online', url: '/ferramentas/personal-presencial-ou-online/' },
  { ref: 'caminho', nome: 'Perto de casa ou do trabalho', url: '/ferramentas/academia-perto-de-casa-ou-do-trabalho/' },
  { ref: 'condominio', nome: 'Treino no condomínio', url: '/ferramentas/treino-academia-do-condominio/' },
  { ref: 'hyrox', nome: 'Calculadora Hyrox', url: '/ferramentas/calculadora-hyrox/' },
  { ref: 'comparador', nome: 'Comparador de academias', url: '/ferramentas/comparador/' },
];
const atual = (u: string): 'page' | undefined => (Astro.url.pathname.startsWith(u) ? 'page' : undefined);
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="google-site-verification" content="e6VP5oV66-qSC_sSckBQBorT0KCg0vC4zPTsKUynmKo" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{tituloCompleto}</title>
  <meta name="description" content={descricao}>
  <link rel="canonical" href={canonical}>
  {(!INDEXAVEL || noindex) && <meta name="robots" content="noindex, nofollow">}
  <meta property="og:type" content={tipo}>
  <meta property="og:site_name" content={SITE}>
  <meta property="og:locale" content="pt_BR">
  <meta property="og:title" content={titulo}>
  <meta property="og:description" content={descricao}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={abs('/og-image.png')}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Guia Fitness Alphaville: academias, boxes e estúdios em Alphaville, Tamboré, Barueri e Santana de Parnaíba">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={abs('/og-image.png')}>
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
  <link rel="icon" type="image/png" sizes="96x96" href="/icon-96.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/icon-48.png">
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#111827">
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo })}></script>
</head>
<body>
  <a class="pula" href="#conteudo">Pular para o conteúdo</a>
  {MOSTRAR_EM_REVISAO && <div class="previa">Pré-visualização · conteúdo em revisão, ainda não aprovado para publicação · páginas sem indexação</div>}
  <header class="topo">
    <div class="wrap">
      <a class="marca" href="/"><Marca /></a>
      <nav class="principal so-desktop" aria-label="Principal">
        <ul>{nav.map((n) => <li><a href={n.url} aria-current={atual(n.url)}>{n.nome}</a></li>)}<li class="nav-destaque"><a href="/ferramentas/academias-diaria-aula-experimental-alphaville/" aria-current={atual('/ferramentas/academias-diaria-aula-experimental-alphaville/')} data-evento="clique_ferramenta" data-ref="menu:diaria">Diária e aula experimental</a></li><li class="nav-montinho"><a href="/montinho/" aria-current={atual('/montinho/')}>Treine com o Montinho</a></li></ul>
      </nav>
      <div class="topo-acoes">
      <Busca />
      <details class="menu-m so-movel">
        <summary>Menu</summary>
        <nav class="principal" aria-label="Principal (celular)">
          <ul>{nav.map((n) => <li><a href={n.url} aria-current={atual(n.url)}>{n.nome}</a></li>)}<li class="nav-destaque"><a href="/ferramentas/academias-diaria-aula-experimental-alphaville/" aria-current={atual('/ferramentas/academias-diaria-aula-experimental-alphaville/')} data-evento="clique_ferramenta" data-ref="menu:diaria">Diária e aula experimental</a></li><li class="nav-montinho"><a href="/montinho/" aria-current={atual('/montinho/')}>Treine com o Montinho</a></li></ul>
        </nav>
      </details>
      </div>
    </div>
  </header>

  {migalhas.length > 0 && (
    <nav class="migalhas wrap" aria-label="Você está em">
      <ol>{trilha.map((m, i) => <li>{i < trilha.length - 1 ? <a href={m.url}>{m.nome}</a> : <span aria-current="page">{m.nome}</span>}</li>)}</ol>
    </nav>
  )}

  <main id="conteudo"><slot /></main>

  <footer class="rodape">
    <div class="wrap">
      <div class="cols">
        <div>
          <a class="marca" href="/"><Marca variante="rodape" /></a>
          <p class="nota">Guia local de academias e treino. Mantido por Montinho Personal Trainer, que atende presencialmente na região. As academias citadas não pagam para aparecer. Encontrou um dado errado? <a href="/correcoes/">Peça a correção</a>.</p>
          <p style="margin-top:12px"><Instagram pagina="rodape" texto="Siga o Montinho: @montinho_personal" /></p>
        </div>
        <div><h2>Guia</h2><ul>{nav.map((n) => <li><a href={n.url}>{n.nome}</a></li>)}<li><a href="/mapa/">Mapa</a></li></ul></div>
        <div><h2>Ferramentas</h2><ul>
          {ferrRodape.map((x) => <li><a href={x.url} data-evento="clique_ferramenta" data-ref={`rodape:${x.ref}`}>{x.ref === 'diaria' ? <strong>{x.nome}</strong> : x.nome}</a></li>)}
          <li><a href="/ferramentas/">Todas as ferramentas</a></li>
        </ul></div>
        <div><h2>Treine com o Montinho</h2><ul>
          {servicos.map((sv) => <li><a href={linkMontinho(sv.url, 'rodape', 'site')} rel="nofollow" data-evento="clique_montinho" data-ref="rodape">{sv.nome}</a></li>)}
          <li><a href="/montinho/"><strong>Todos os serviços</strong></a></li>
        </ul></div>
        <div><h2>Transparência</h2><ul>
          <li><a href="/sobre/">Sobre</a></li><li><a href="/metodologia/">Metodologia</a></li><li><a href="/politica-editorial/">Política editorial</a></li><li><a href="/correcoes/">Correções</a></li><li><a href="/privacidade/">Privacidade</a></li>
          <li><button type="button" id="abrir-consent" style="background:none;border:0;padding:0;font:inherit;color:inherit;text-decoration:underline;cursor:pointer">Preferências de cookies</button></li>
        </ul></div>
      </div>
    </div>
  </footer>

  <BarraWhatsapp pagina={Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'inicio'} />
  <div class="consent" id="consent" role="dialog" aria-labelledby="consent-t" hidden>
    <p id="consent-t"><strong>Medição de audiência.</strong> Usamos cookies de análise para saber quais páginas ajudam mais. Nada é carregado sem o seu aceite. <a href="/privacidade/">Privacidade</a>.</p>
    <div class="acoes">
      <button class="btn peq" type="button" data-consent="sim">Aceitar</button>
      <button class="btn peq sec" type="button" data-consent="nao">Recusar</button>
    </div>
  </div>

  <script>import '../scripts/seletor.ts';</script>
  <script is:inline define:vars={{ GTM_ID }}>
    // Medição só após consentimento. Sem GTM_ID configurado, nada é carregado e o aviso não aparece.
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    (function () {
      var CHAVE = 'ota-consent', caixa = document.getElementById('consent'), GA4 = /^G-/.test(GTM_ID || '');
      function evento(nome, dados) {
        dados = dados || {};
        if (dados.termo && !dados.search_term) dados.search_term = dados.termo; // nome recomendado pelo GA4
        if (GA4) gtag('event', nome, dados); else dataLayer.push(Object.assign({ event: nome }, dados));
      }
      var escolha = null; try { escolha = localStorage.getItem(CHAVE); } catch (e) {}
      function carregar() {
        if (!GTM_ID || window.__gtm) return; window.__gtm = true;
        gtag('consent', 'update', { analytics_storage: 'granted' });
        var s = document.createElement('script'); s.async = true;
        if (GA4) {
          // ID do GA4 (G-...): tag do Google direto, sem contêiner do GTM.
          gtag('js', new Date()); gtag('config', GTM_ID, { content_group: (location.pathname.split('/')[1] || 'inicio') });
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GTM_ID;
        } else {
          dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
        }
        document.head.appendChild(s);
      }
      if (escolha === 'sim') carregar(); else if (!escolha && GTM_ID) caixa.hidden = false;
      caixa.addEventListener('click', function (e) {
        var v = e.target.getAttribute && e.target.getAttribute('data-consent'); if (!v) return;
        try { localStorage.setItem(CHAVE, v); } catch (e2) {}
        caixa.hidden = true; if (v === 'sim') carregar();
      });
      document.getElementById('abrir-consent').addEventListener('click', function () { caixa.hidden = false; caixa.querySelector('button').focus(); });
      // Cliques: todo link é medido. data-evento dá o nome; sem ele, o nome sai do destino.
      // Links para o site do Montinho sem UTM recebem UTM na hora do clique, para o GA4 de lá atribuir a origem.
      var MONT = /(^|\.)montinhopersonal\.com\.br$/;
      function nomePorDestino(u) {
        var h = u.hostname;
        if (u.protocol === 'tel:') return 'clique_telefone';
        if (u.protocol === 'mailto:') return 'clique_email';
        if (h === location.hostname) return null;
        if (/(^|\.)wa\.me$|whatsapp\.com$/.test(h)) return 'clique_whatsapp';
        if (MONT.test(h)) return 'clique_montinho';
        if (/instagram\.com$/.test(h)) return 'clique_instagram';
        if (/youtube\.com$|youtu\.be$/.test(h)) return 'clique_youtube';
        if (/wellhub\.com$|gympass\.com$|totalpass\.com$/.test(h)) return 'clique_agregador';
        if (/google\.[a-z.]+$/.test(h) && /maps|dir|place|search/.test(u.pathname + u.search)) return 'clique_mapa_externo';
        return 'clique_saida';
      }
      function aoClicar(e) {
        var a = e.target.closest && e.target.closest('a[href]'); if (!a) return;
        var u; try { u = new URL(a.href, location.href); } catch (x) { return; }
        if (MONT.test(u.hostname) && !u.searchParams.has('utm_source') && !/^\/l\//.test(u.pathname)) {
          u.searchParams.set('utm_source', 'guiafitnessalphaville'); u.searchParams.set('utm_medium', 'referral');
          u.searchParams.set('utm_campaign', 'link'); u.searchParams.set('utm_content', location.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'inicio');
          a.href = u.href;
        }
        var nome = a.getAttribute('data-evento') || nomePorDestino(u); if (!nome) return;
        evento(nome, {
          ref: a.getAttribute('data-ref') || '', pagina: location.pathname,
          link_url: u.href.slice(0, 300), link_domain: u.hostname, link_text: (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 100),
          outbound: u.hostname !== location.hostname
        });
      }
      document.addEventListener('click', aoClicar, true);
      document.addEventListener('auxclick', function (e) { if (e.button === 1) aoClicar(e); }, true);
      // Elementos que não são link (botões com data-evento).
      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-evento]:not(a)'); if (!el) return;
        evento(el.getAttribute('data-evento'), { ref: el.getAttribute('data-ref') || '', pagina: location.pathname });
      });
      // Perguntas frequentes abertas e menu do celular.
      document.addEventListener('toggle', function (e) {
        var d = e.target; if (!d || d.tagName !== 'DETAILS' || !d.open) return;
        if (d.classList.contains('menu-m')) { evento('menu_aberto', { pagina: location.pathname }); return; }
        if (!d.closest('.perguntas')) return;
        var t = d.querySelector('summary'); evento('pergunta_aberta', { pergunta: t ? t.textContent.trim().slice(0, 100) : '', pagina: location.pathname });
      }, true);
      window.otaEvento = function (nome, dados) { evento(nome, Object.assign({ pagina: location.pathname }, dados || {})); };
    })();
  </script>
</body>
</html>
