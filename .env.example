# true só depois da aprovação editorial e do lançamento. Enquanto for false,
# todas as páginas saem com noindex e o robots.txt bloqueia o rastreamento.
PUBLIC_INDEXAVEL=false
# true inclui no build o conteúdo que ainda não foi aprovado (pré-visualização).
# Não pode ser true junto com PUBLIC_INDEXAVEL=true: o build falha.
PUBLIC_MOSTRAR_EM_REVISAO=true
# ID do contêiner do Google Tag Manager (GTM-XXXXXXX). Vazio = sem medição.
PUBLIC_GTM_ID=
# WhatsApp do Montinho, só dígitos com DDI.
PUBLIC_WHATSAPP=5511981063409
# E-mail público de contato e de privacidade. Vazio = só WhatsApp aparece nas páginas.
PUBLIC_EMAIL_CONTATO=
